+
+    .nav-links { display: flex; gap: 22px; }
+    .nav-links a { color: var(--muted); font-size: .9rem; text-decoration: none; }
+    .nav-links a:hover { color: var(--ink); }
+
+    .hero { padding: 92px 0 96px; }
