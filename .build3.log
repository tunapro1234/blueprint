+      font: inherit;
+      font-size: .78rem;
+      font-weight: 700;
+    }
+
+    .copy:hover { background: #23304a; color: white; }
+
+    main section { padding: 74px 0; border-bottom: 1px solid var(--line); }
+    h2 { margin: 0 0 26px; }
+
+    h3 {
+      margin: 0 0 8px;
