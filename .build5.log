+// Location records both the current pane directory and the directory in which
+// its tmux session was created.
+type Location struct {
+	Session    string
+	CurrentDir string
+	StartDir   string
+}
+
 func New() *Client {
 	return &Client{Bin: "tmux", Sleep: time.Sleep}
 }
