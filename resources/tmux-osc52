#!/bin/bash
# Encodes stdin as base64 and writes OSC52 to the tmux CLIENT tty -> local terminal clipboard.
# Works independently of tmux set-clipboard/allow-passthrough settings.
data=$(base64 -w0)
tty=$(tmux display-message -p '#{client_tty}' 2>/dev/null)
[ -n "$tty" ] && [ -w "$tty" ] && printf '\033]52;c;%s\a' "$data" > "$tty"
