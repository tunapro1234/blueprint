--- a/install.sh
+++ b/install.sh
@@ -3,7 +3,16 @@
 
 SERVER_ROOT=/srv/blueprint
 INSTALL_MODE=${BP_INSTALL_MODE:-}
+YES=${BP_YES:-0}
 
+while [ "$#" -gt 0 ]; do
