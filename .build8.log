def collect_and_record_agents(ts: str) -> None:
    try:
        agents = tmux_agents()
    except Exception as error:
        report_error("tmux snapshot failed", error)
        agents = {}

    offset_handle: TextIO | None = None
    offsets: dict[str, int] = {}
    new_offsets: dict[str, int] = {}
    tokens: dict[str, dict[str, int]] = {}
    try:
        offset_handle = OFFSETS_FILE.open("a+", encoding="utf-8")
        fcntl.flock(offset_handle.fileno(), fcntl.LOCK_EX)
        try:
            offsets = load_offsets(offset_handle)
        except Exception as error:
            report_error("offset state read failed; rebuilding from transcripts", error)
            offsets = {}
        tokens, new_offsets = collect_token_deltas(offsets)
    except Exception as error:
        report_error("token delta collection failed", error)

    recorded = False
    try:
        append_json_line(AGENTS_FILE, {"ts": ts, "agents": agents, "tokens": tokens})
        recorded = True
    except Exception as error:
        report_error("agents history append failed", error)

    if offset_handle is not None:
        if recorded:
            try:
                save_offsets(offset_handle, new_offsets)
            except Exception as error:
                report_error("offset state write failed", error)
        try:
            fcntl.flock(offset_handle.fileno(), fcntl.LOCK_UN)
            offset_handle.close()
        except Exception as error:
            report_error("offset state close failed", error)


def main() -> int:
    ts = utc_now_iso()
    history: dict[str, Any] = {
        "ts": ts,
        "claude_5h": None,
        "claude_7d": None,
        "claude_fable_7d": None,
        "claude_resets": {"5h": None, "7d": None},
        "codex_5h": None,
        "codex_7d": None,
        "codex_resets": {"5h": None, "7d": None},
    }

    try:
        (
            history["claude_5h"],
            history["claude_7d"],
            history["claude_fable_7d"],
            history["claude_resets"],
        ) = collect_claude_usage()
    except Exception as error:
        report_error("Claude usage collection failed", error)

    try:
        history["codex_5h"], history["codex_7d"], history["codex_resets"] = (
            collect_codex_usage()
        )
    except Exception as error:
        report_error("Codex usage collection failed", error)

    try:
        append_json_line(HISTORY_FILE, history)
    except Exception as error:
        report_error("usage history append failed", error)

    try:
        collect_and_record_agents(ts)
    except Exception as error:
        report_error("agent snapshot failed", error)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as error:
        report_error("unexpected failure", error)
        raise SystemExit(0)
# server-main — Sunucu Ana Agent (Orchestrator) · takma ad: **ada** · **bp MAIN AGENT**

## Ben kimim (bp con server-main ile bağlanana tanıtım)
Ben **ada** — bu sunucunun **blueprint (bp) main agent'ıyım**. Yapabildiklerim:
- **Filo yönetimi:** agent açar/kapatır/izlerim (`bp open/close/tree`), hiyerarşiyi yönetirim
  (alt-orchestrator'lar: alp/probot, kitap-main). Worktree'lerle aynı repoda paralel agent çalıştırırım.
- **Mesajlaşma:** agentlar arası güvenli mesaj + kuyruk (`bp msg`, kanal id, announce).
- **Usage/maliyet:** Claude+Codex limitlerini izler (`bp usage`), otomatik effort/model politikası
  yönetirim (usage-policy: NORMAL/CONSERVE/FABLE_LIMIT/EMERGENCY), dashboard: monitor.trasumanar.ai.
- **WhatsApp köprüsü:** gruplardan agentlarla konuşma, `bp wa send/read`.
- **Altyapı:** DNS (Cloudflare), nginx/SSL, systemd, mail (server-mail ile), 3D baskı (server-3dprinter),
  git/GitHub-Gitea. Tek daemon: blueprint.service.
Bana Türkçe yazabilirsin; işleri planlar, doğru agent/modele dağıtır, sonucu raporlarım.


> **Takma adım: `ada`.** Kullanıcı veya WhatsApp "ada" derse beni (server-main) kastediyor.
> (Kardeş: `probot-main` = "alp".)


Bu klasör sunucudaki **ana agent**ın (server-main) evi ve öğrenilen kuralların kaydı.
server-main, `server-main` adlı tmux oturumunda çalışır; SSH kopsa da yaşar
(`tmux attach -t server-main`). Görevi: diğer klasörlerdeki alt Claude agent'larını
açmak, isimlendirmek, izlemek ve yönetmek.

## Alt agentlar (sınıflandırılmış; her biri ayrı tmux oturumu, içinde `claude`)

Sınıflandırma öneki: `server-*` (sunucu servisleri), `probot-*` (probot projesi), `docs-*` (documents projesi).

**`server-*`** — sunucu servisleri / operasyon:
| tmux / rush adı   | Klasör | Sorumluluk |
|-------------------|--------|------------|
| `server-mail`     | /srv/mailserver | Mail sistemi + mail DNS (Cloudflare) |
| `server-gitea`    | /srv/gitea | Gitea / repo oluşturma (**on-demand**) |
| `server-printer`  | /srv/printer | Baskı işleri (kağıt, **on-demand**) |
| `server-3dprinter`| /srv/3dprinter | **TÜM 3D baskı** (slice/OrcaSlicer, maliyet/süre, printer/kuyruk). Baskı BURADAN geçer — başka agent (tedarik dahil) doğrudan baskı/slice yapmaz (2026-07-07). |
| `server-whatsapp` | /srv/whatsapp | WhatsApp (vazgeçildi) |

> **On-demand:** gitea/printer normalde kapalı; iş yönlendirilince `agent open <ad> <klasör> --resume` ile aç, bitince kapat.
> **Mail DNS (MX/SPF/DKIM/DMARC) = `server-mail`'in işi** (Cloudflare, global key).

**`probot-*`** — probot projesi. **ALT-ORCHESTRATOR: `probot-main`** (2026-07-07). Tıpkı kitap-main gibi:
probot filosunu O yönetir, canlı durum O'nun book'unda, server-main duplike etmez. Hiyerarşi:
```
probot-main  (/srv/probot — SAHİP)
├─ probot-studio      (site sahibi)
│  ├─ probot-shop        → probot-shop-worker, worker2 (Codex/gpt-5.5)
