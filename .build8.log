#!/usr/bin/env python3
"""Build the static usage dashboard data file from local usage logs."""

from __future__ import annotations

import json
import math
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any


HISTORY_FILE = Path("/srv/server-main/usage/history.jsonl")
AGENTS_FILE = Path("/srv/server-main/usage/agents.jsonl")
AGENTBOOK_FILES = (
    Path("/srv/server-main/agentbook.json"),
    Path("/srv/probot/.orchestration/agentbook.json"),
)
OUTPUT_FILE = Path("/srv/usage-dashboard/data.json")


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def iso_utc(value: datetime) -> str:
    return value.astimezone(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def parse_timestamp(value: Any) -> datetime | None:
    if not isinstance(value, str) or not value.strip():
        return None
    candidate = value.strip()
    if candidate.endswith("Z"):
        candidate = candidate[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(candidate)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def number(value: Any) -> int | float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if not math.isfinite(value):
        return None
    return value


def token_number(value: Any) -> int:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return 0
    if not math.isfinite(value) or value <= 0:
        return 0
    return int(value)


def read_jsonl(path: Path, cutoff: datetime) -> list[tuple[datetime, dict[str, Any]]]:
    records: list[tuple[datetime, dict[str, Any]]] = []
    with path.open("r", encoding="utf-8") as handle:
        for line_number, line in enumerate(handle, start=1):
            if not line.strip():
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError as error:
                print(f"usage-dashboard-gen: {path}:{line_number}: gecersiz JSON: {error}", file=sys.stderr)
                continue
            if not isinstance(record, dict):
                continue
            timestamp = parse_timestamp(record.get("ts"))
            if timestamp is not None and timestamp >= cutoff:
                records.append((timestamp, record))
    records.sort(key=lambda item: item[0])
    return records


def provider_data(
    records: list[tuple[datetime, dict[str, Any]]], provider: str
) -> dict[str, Any]:
    latest = records[-1][1] if records else {}
    raw_resets = latest.get(f"{provider}_resets")
    resets = raw_resets if isinstance(raw_resets, dict) else {}
    history = [
        {
            "ts": iso_utc(timestamp),
            "p5h": number(record.get(f"{provider}_5h")),
            "p7d": number(record.get(f"{provider}_7d")),
        }
        for timestamp, record in records
    ]
    return {
        "p5h": number(latest.get(f"{provider}_5h")),
        "p7d": number(latest.get(f"{provider}_7d")),
        "resets": {
            "5h": resets.get("5h"),
            "7d": resets.get("7d"),
        },
        "history": history,
    }


def current_agents(records: list[tuple[datetime, dict[str, Any]]]) -> dict[str, str]:
    if not records:
        return {}
    raw_agents = records[-1][1].get("agents")
    if not isinstance(raw_agents, dict):
        return {}
    return {
        name: "busy" if state == "busy" else "idle"
        for name, state in sorted(raw_agents.items())
        if isinstance(name, str) and name
    }


def hourly_tokens(
    records: list[tuple[datetime, dict[str, Any]]]
) -> list[dict[str, Any]]:
    buckets: dict[datetime, dict[str, dict[str, int]]] = defaultdict(
        lambda: defaultdict(lambda: {"in_tokens": 0, "out_tokens": 0})
    )
    for timestamp, record in records:
        raw_tokens = record.get("tokens")
        if not isinstance(raw_tokens, dict):
            continue
        hour = timestamp.replace(minute=0, second=0, microsecond=0)
        for project, raw_counts in raw_tokens.items():
            if not isinstance(project, str) or not project or not isinstance(raw_counts, dict):
                continue
            buckets[hour][project]["in_tokens"] += token_number(raw_counts.get("in"))
            buckets[hour][project]["out_tokens"] += token_number(raw_counts.get("out"))

    result: list[dict[str, Any]] = []
    for hour in sorted(buckets):
        item: dict[str, Any] = {"ts": iso_utc(hour)}
        for project in sorted(buckets[hour]):
            item[project] = buckets[hour][project]
        result.append(item)
    return result


def read_agent_tree(paths: tuple[Path, ...]) -> list[dict[str, str | None]]:
    nodes: dict[str, str | None] = {}
    order: list[str] = []

    for path in paths:
        with path.open("r", encoding="utf-8") as handle:
            book = json.load(handle)
        if not isinstance(book, dict):
            raise ValueError(f"{path}: agentbook bir JSON nesnesi degil")
        orchestrator = book.get("orchestrator")
        book_parent = book.get("parent")
        if not isinstance(orchestrator, str) or not orchestrator:
            orchestrator = None
        if not isinstance(book_parent, str) or not book_parent:
            book_parent = None

        raw_agents = book.get("agents")
        if not isinstance(raw_agents, list):
            continue
        for raw_agent in raw_agents:
            if not isinstance(raw_agent, dict):
                continue
            name = raw_agent.get("name")
            if not isinstance(name, str) or not name or "*" in name:
                continue
            explicit_parent = raw_agent.get("parent")
            if not isinstance(explicit_parent, str) or not explicit_parent:
                explicit_parent = None
            parent = explicit_parent
            if parent is None:
                parent = book_parent if name == orchestrator else orchestrator
            if parent == name:
                parent = None

            if name not in nodes:
                nodes[name] = parent
                order.append(name)
            elif nodes[name] is None and parent is not None:
                nodes[name] = parent

    return [{"name": name, "parent": nodes[name]} for name in order]


def main() -> int:
    now = utc_now()
    history_records = read_jsonl(HISTORY_FILE, now - timedelta(days=7))
    agent_records = read_jsonl(AGENTS_FILE, now - timedelta(hours=48))

    payload = {
        "generated_ts": iso_utc(now),
        "claude": provider_data(history_records, "claude"),
        "codex": provider_data(history_records, "codex"),
        "agents_now": current_agents(agent_records),
        "agent_tree": read_agent_tree(AGENTBOOK_FILES),
        "tokens_hourly": hourly_tokens(agent_records),
    }

    OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)
    with OUTPUT_FILE.open("w", encoding="utf-8") as handle:
        json.dump(payload, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
    print(f"usage-dashboard-gen: {OUTPUT_FILE} olusturuldu")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"usage-dashboard-gen: hata: {error}", file=sys.stderr)
        raise SystemExit(1)
