#!/usr/bin/env python3
"""Apply a hysteretic Claude fleet policy from the latest usage-pulse sample."""

from __future__ import annotations

import fcntl
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any


USAGE_DIR = Path("/srv/server-main/usage")
HISTORY_FILE = USAGE_DIR / "history.jsonl"
STATE_FILE = USAGE_DIR / "policy-state.json"
LOG_FILE = USAGE_DIR / "policy.log"
LOCK_FILE = USAGE_DIR / ".policy.lock"
CONFIG_FILE = USAGE_DIR / "autopilot.conf"
PROJECTS_DIR = Path("/root/.claude/projects")
AGENTBOOKS = (
    Path("/srv/server-main/agentbook.json"),
    Path("/srv/probot/.orchestration/agentbook.json"),
)
WA_BIN = Path("/srv/server-main/bin/wa")

VALID_STATES = {"NORMAL", "FABLE_LIMIT", "CONSERVE", "EMERGENCY"}
VALID_MODELS = {"fable", "opus"}
VALID_EFFORTS = {"low", "medium", "high", "xhigh"}
STALE_SECONDS = 20 * 60
BRAKE_INTERVAL_SECONDS = 6 * 60 * 60


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def iso(value: datetime | None = None) -> str:
    return (value or utc_now()).isoformat(timespec="seconds").replace("+00:00", "Z")


def parse_time(value: Any) -> datetime | None:
    if not isinstance(value, str) or not value.strip():
        return None
    candidate = value.strip()
    if candidate.endswith("Z"):
        candidate = candidate[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(candidate)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def number(value: Any) -> float | None:
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)) and math.isfinite(float(value)):
        return float(value)
    if isinstance(value, str):
        try:
            parsed = float(value.strip().removesuffix("%"))
        except ValueError:
            return None
        return parsed if math.isfinite(parsed) else None
    return None


def fmt(value: float | None, digits: int = 1) -> str:
    if value is None:
        return "null"
    if float(value).is_integer():
        return str(int(value))
    return f"{value:.{digits}f}"


def default_state() -> dict[str, Any]:
    return {
        "state": "NORMAL",
        "pending": None,
        "pending_count": 0,
        "last_change": None,
        "override_until": None,
        "applied": {},
    }


def load_state(errors: list[str]) -> dict[str, Any]:
    state = default_state()
    try:
        raw = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if not isinstance(raw, dict):
            raise ValueError("state is not an object")
    except FileNotFoundError:
        return state
    except Exception as error:
        errors.append(f"state-read:{error}")
        return state

    if raw.get("state") in VALID_STATES:
        state["state"] = raw["state"]
    state["pending"] = raw.get("pending") if raw.get("pending") in VALID_STATES else None
    pending_count = raw.get("pending_count")
    if isinstance(pending_count, int) and not isinstance(pending_count, bool) and pending_count >= 0:
        state["pending_count"] = pending_count
    for key in ("last_change", "override_until"):
        value = raw.get(key)
        state[key] = value if value is None or isinstance(value, str) else None
    if isinstance(raw.get("applied"), dict):
        state["applied"] = raw["applied"]
    return state


def save_state(state: dict[str, Any]) -> None:
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=".policy-state.", dir=USAGE_DIR, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, STATE_FILE)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def append_log(record: dict[str, Any]) -> None:
    try:
        USAGE_DIR.mkdir(parents=True, exist_ok=True)
        line = json.dumps(record, ensure_ascii=False, separators=(",", ":"), default=str)
        line = line.replace("\n", "\\n").replace("\r", "\\r")
        with LOG_FILE.open("a", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            handle.write(line + "\n")
            handle.flush()
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    except Exception as error:
        print(f"usage-policy: log failed: {error}", file=sys.stderr)


def load_mode(errors: list[str]) -> str:
    try:
        lines = CONFIG_FILE.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return "enforce"
    except Exception as error:
        errors.append(f"config-read:{error}")
        return "enforce"
    for raw_line in lines:
        line = raw_line.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key == "mode":
            mode = value.strip("\"'").lower()
            if mode in {"advise", "enforce"}:
                return mode
            errors.append(f"config-mode:{mode or 'empty'}")
            return "enforce"
    return "enforce"


def last_history_record() -> dict[str, Any]:
    with HISTORY_FILE.open("rb") as handle:
        handle.seek(0, os.SEEK_END)
        position = handle.tell()
        if position == 0:
            raise ValueError("history is empty")
        buffer = b""
        while position > 0:
            size = min(65536, position)
            position -= size
            handle.seek(position)
            buffer = handle.read(size) + buffer
            lines = buffer.splitlines()
            for raw in reversed(lines[1:] if position > 0 else lines):
                if raw.strip():
                    parsed = json.loads(raw)
                    if not isinstance(parsed, dict):
                        raise ValueError("last history row is not an object")
                    return parsed
            buffer = lines[0] if lines and position > 0 else b""
    raise ValueError("history has no record")


def metrics_from_history(record: dict[str, Any], now: datetime) -> dict[str, Any]:
    recorded_at = parse_time(record.get("ts"))
    if recorded_at is None:
        raise ValueError("history timestamp is missing or invalid")
    age_seconds = (now - recorded_at).total_seconds()
    if age_seconds > STALE_SECONDS:
        raise RuntimeError(f"stale:{int(age_seconds)}s")

    resets = record.get("claude_resets")
    reset_at = parse_time(resets.get("7d")) if isinstance(resets, dict) else None
    seven_day = number(record.get("claude_7d"))
    if seven_day is None or reset_at is None:
        raise ValueError("claude_7d or claude_resets.7d is unavailable")
    reset_hours = (reset_at - now).total_seconds() / 3600
    expected = (1 - reset_hours / 168) * 100
    return {
        "ts": recorded_at,
        "age_seconds": age_seconds,
        "claude_5h": number(record.get("claude_5h")),
        "claude_7d": seven_day,
        "claude_fable_7d": number(record.get("claude_fable_7d")),
        "reset_at": reset_at,
        "reset_hours": reset_hours,
        "expected": expected,
    }


def candidate_state(metrics: dict[str, Any]) -> str:
    seven_day = metrics["claude_7d"]
    fable = metrics["claude_fable_7d"]
    reset_hours = metrics["reset_hours"]
    expected = metrics["expected"]
    if seven_day >= 90 and reset_hours > 24:
        return "EMERGENCY"
    if fable is not None and fable >= 80 and reset_hours > 12:
        return "FABLE_LIMIT"
    if seven_day > expected * 1.5 and seven_day >= 30:
        return "CONSERVE"
    return "NORMAL"


def advance_hysteresis(state: dict[str, Any], candidate: str, now: datetime) -> tuple[bool, str]:
    old_state = state["state"]
    if candidate == old_state:
        state["pending"] = None
        state["pending_count"] = 0
        return False, old_state
    if state.get("pending") == candidate:
        state["pending_count"] = int(state.get("pending_count", 0)) + 1
    else:
        state["pending"] = candidate
        state["pending_count"] = 1
    if state["pending_count"] < 2:
        return False, old_state
    state["state"] = candidate
    state["pending"] = None
    state["pending_count"] = 0
    state["last_change"] = iso(now)
    return True, old_state


def run_process(args: list[str], timeout: float = 10, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
        env=env,
    )


def tmux_sessions(errors: list[str]) -> set[str]:
    try:
        result = run_process(["tmux", "list-sessions", "-F", "#{session_name}"])
    except Exception as error:
        errors.append(f"tmux-list:{error}")
        return set()
    if result.returncode != 0:
        message = result.stderr.strip()
        if "no server running" not in message.lower():
            errors.append(f"tmux-list:{message or result.returncode}")
