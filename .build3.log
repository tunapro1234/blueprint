+    }
+
+    .node { border: 1px solid var(--line); border-radius: 8px; padding: 9px 12px; background: var(--soft); }
+
+    footer { padding: 32px 0 54px; color: var(--muted); font-size: .85rem; }
+
+    @media (max-width: 760px) {
