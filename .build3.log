+    tbody tr:hover { background: #fafbfe; }
+
+    .architecture {
+      display: grid;
+      grid-template-columns: 1fr 2fr;
+      gap: 34px;
+      align-items: start;
+    }
+
+    .architecture h3 { font-size: clamp(1.5rem, 4vw, 2.4rem); line-height: 1.15; }
+
+    .flow {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 10px;
+      margin-top: 25px;
