#!/usr/bin/env python3
"""Collect Claude/Codex usage, tmux state, and Claude transcript deltas."""

from __future__ import annotations

import fcntl
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, TextIO


CLAUDE_CREDENTIALS = Path("/root/.claude/.credentials.json")
CODEX_AUTH = Path("/root/.codex/auth.json")
CLAUDE_PROJECTS = Path("/root/.claude/projects")

USAGE_DIR = Path("/srv/server-main/usage")
HISTORY_FILE = USAGE_DIR / "history.jsonl"
AGENTS_FILE = USAGE_DIR / "agents.jsonl"
OFFSETS_FILE = USAGE_DIR / "offsets.json"

CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CODEX_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
HTTP_TIMEOUT_SECONDS = 20


def report_error(context: str, error: object) -> None:
    """Report a concise error without exposing credentials or response bodies."""
    if isinstance(error, urllib.error.HTTPError):
        detail = f"HTTP {error.code} {error.reason}"
    elif isinstance(error, urllib.error.URLError):
        detail = str(error.reason)
    else:
        detail = str(error)
    print(f"usage-pulse: {context}: {detail}", file=sys.stderr)


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def read_json_file(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def fetch_json(url: str, headers: dict[str, str]) -> Any:
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "User-Agent": "usage-pulse/1.0",
            **headers,
        },
        method="GET",
    )
    with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
        return json.load(response)


def percentage(value: Any) -> int | float | None:
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return value
    if isinstance(value, str):
        candidate = value.strip().removesuffix("%")
        try:
            parsed = float(candidate)
        except ValueError:
            return None
        return int(parsed) if parsed.is_integer() else parsed
    return None


def reset_time(value: Any) -> Any:
    """Normalize epoch reset timestamps to UTC ISO; preserve ISO/string values."""
    if isinstance(value, bool) or value is None:
        return None
    epoch: float | None = None
    if isinstance(value, (int, float)):
        epoch = float(value)
    elif isinstance(value, str):
        candidate = value.strip()
        try:
            epoch = float(candidate)
        except ValueError:
            return value
    if epoch is not None:
        try:
            return datetime.fromtimestamp(epoch, timezone.utc).isoformat(timespec="seconds").replace(
                "+00:00", "Z"
            )
        except (OverflowError, OSError, ValueError):
            return value
    return value


def collect_claude_usage() -> tuple[Any, Any, Any, dict[str, Any]]:
    credentials = read_json_file(CLAUDE_CREDENTIALS)
    token = credentials["claudeAiOauth"]["accessToken"]
    payload = fetch_json(
        CLAUDE_USAGE_URL,
        {
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
        },
    )
    five_hour = payload["five_hour"]
    seven_day = payload["seven_day"]
    fable_seven_day = None
    limits = payload.get("limits") if isinstance(payload, dict) else None
    if isinstance(limits, list):
        for limit in limits:
            if not isinstance(limit, dict) or limit.get("kind") != "weekly_scoped":
                continue
            scope = limit.get("scope")
            model = scope.get("model") if isinstance(scope, dict) else None
            if isinstance(model, dict) and model.get("display_name") == "Fable":
                fable_seven_day = percentage(limit.get("percent"))
                break
    return (
        percentage(five_hour.get("utilization")),
        percentage(seven_day.get("utilization")),
        fable_seven_day,
        {
            "5h": reset_time(five_hour.get("resets_at")),
            "7d": reset_time(seven_day.get("resets_at")),
        },
    )


def codex_window_container(payload: Any) -> dict[str, Any]:
    if not isinstance(payload, dict):
        raise ValueError("usage response is not a JSON object")

    rate_limit = payload.get("rate_limit")
    if isinstance(rate_limit, dict) and (
        "primary_window" in rate_limit or "secondary_window" in rate_limit
    ):
        return rate_limit
    if "primary_window" in payload or "secondary_window" in payload:
        return payload

    # Keep compatibility if the endpoint adds a single wrapper around rate_limit.
    for value in payload.values():
        if isinstance(value, dict) and (
            "primary_window" in value or "secondary_window" in value
        ):
            return value
    raise KeyError("primary_window/secondary_window not found")


def collect_codex_usage() -> tuple[Any, Any, dict[str, Any]]:
    auth = read_json_file(CODEX_AUTH)
    tokens = auth["tokens"]
    payload = fetch_json(
        CODEX_USAGE_URL,
        {
            "Authorization": f"Bearer {tokens['access_token']}",
            "chatgpt-account-id": tokens["account_id"],
        },
    )
    windows = codex_window_container(payload)
    primary = windows.get("primary_window") or {}
    secondary = windows.get("secondary_window") or {}
    if not isinstance(primary, dict) or not isinstance(secondary, dict):
        raise ValueError("invalid Codex usage window")
    return (
        percentage(primary.get("used_percent")),
        percentage(secondary.get("used_percent")),
        {
            "5h": reset_time(primary.get("reset_at")),
            "7d": reset_time(secondary.get("reset_at")),
        },
    )


def append_json_line(path: Path, record: dict[str, Any]) -> None:
    line = json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n"
    with path.open("a", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        handle.write(line)
        handle.flush()
        os.fsync(handle.fileno())
        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def tmux_agents() -> dict[str, str]:
    result = subprocess.run(
        ["tmux", "ls", "-F", "#{session_name}"],
        capture_output=True,
        text=True,
        timeout=10,
        check=False,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or f"tmux ls exited {result.returncode}"
        # An absent tmux server simply means there are no open agents.
        if "no server running" not in message.lower():
            report_error("tmux session list failed", message)
        return {}

    agents: dict[str, str] = {}
    for name in (line.strip() for line in result.stdout.splitlines()):
        if not name:
            continue
        try:
            capture = subprocess.run(
                ["tmux", "capture-pane", "-p", "-t", name],
                capture_output=True,
                text=True,
                timeout=10,
                check=False,
            )
            if capture.returncode != 0:
                message = capture.stderr.strip() or f"capture-pane exited {capture.returncode}"
                report_error(f"tmux capture failed for {name}", message)
            agents[name] = "busy" if "esc to interrupt" in capture.stdout.lower() else "idle"
        except Exception as error:  # Keep other sessions observable.
            report_error(f"tmux capture failed for {name}", error)
            agents[name] = "idle"
    return agents


def load_offsets(handle: TextIO) -> dict[str, int]:
    handle.seek(0)
    raw = handle.read()
    if not raw.strip():
        return {}
    parsed = json.loads(raw)
    if not isinstance(parsed, dict):
        raise ValueError("offset state is not a JSON object")
    offsets: dict[str, int] = {}
    for path, value in parsed.items():
        if isinstance(path, str) and isinstance(value, int) and not isinstance(value, bool) and value >= 0:
            offsets[path] = value
    return offsets


def token_count(value: Any) -> int:
    if isinstance(value, bool):
        return 0
    if isinstance(value, int):
        return max(0, value)
    if isinstance(value, float) and value.is_integer():
        return max(0, int(value))
    return 0


def collect_token_deltas(offsets: dict[str, int]) -> tuple[dict[str, dict[str, int]], dict[str, int]]:
    totals: dict[str, dict[str, int]] = {}
    new_offsets = dict(offsets)

    try:
        transcripts = sorted(CLAUDE_PROJECTS.glob("*/*.jsonl"))
    except Exception as error:
        report_error("transcript list failed", error)
        return totals, new_offsets

    for transcript in transcripts:
        path_key = str(transcript)
        try:
            size = transcript.stat().st_size
            offset = offsets.get(path_key, 0)
            if offset > size:
                offset = 0

            committed_offset = offset
            with transcript.open("rb") as handle:
                handle.seek(offset)
                while True:
                    line_start = handle.tell()
                    line = handle.readline()
                    if not line:
                        break
                    if not line.endswith(b"\n"):
                        committed_offset = line_start
                        break
                    committed_offset = handle.tell()
                    try:
                        entry = json.loads(line)
                    except (json.JSONDecodeError, UnicodeDecodeError) as error:
                        report_error(f"invalid transcript line in {transcript}", error)
                        continue

                    message = entry.get("message") if isinstance(entry, dict) else None
                    usage = message.get("usage") if isinstance(message, dict) else None
                    if not isinstance(usage, dict):
                        continue

                    project = transcript.parent.name
                    project_totals = totals.setdefault(
                        project,
                        {"in": 0, "out": 0, "cache_r": 0, "cache_w": 0},
                    )
                    project_totals["in"] += token_count(usage.get("input_tokens"))
                    project_totals["out"] += token_count(usage.get("output_tokens"))
                    project_totals["cache_r"] += token_count(
                        usage.get("cache_read_input_tokens")
                    )
                    project_totals["cache_w"] += token_count(
                        usage.get("cache_creation_input_tokens")
                    )
            new_offsets[path_key] = committed_offset
        except Exception as error:  # One damaged/unreadable transcript must not stop the rest.
            report_error(f"transcript read failed for {transcript}", error)

    return totals, new_offsets


def save_offsets(handle: TextIO, offsets: dict[str, int]) -> None:
    handle.seek(0)
    handle.truncate()
    json.dump(offsets, handle, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
