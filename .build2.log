+	q.Now = func() time.Time { return current }
+	first, err := q.Enqueue("one", "sender", "first")
+	if err != nil {
+		t.Fatal(err)
+	}
+	current = current.Add(time.Nanosecond)
+	second, err := q.Enqueue("two", "sender", "second")
+	if err != nil {
