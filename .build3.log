+
+    .number {
+      display: inline-grid;
+      place-items: center;
+      width: 28px;
+      height: 28px;
+      margin-bottom: 18px;
+      border-radius: 50%;
+      background: var(--blue);
+      color: white;
+      font-size: .75rem;
+      font-weight: 800;
+    }
+
+    pre {
+      margin: 16px 0 0;
+      overflow-x: auto;
+      border-radius: 9px;
+      padding: 14px;
+      background: var(--code);
+      color: var(--code-ink);
+      font: .79rem/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+    }
+
+    .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }
+
+    table { width: 100%; border-collapse: collapse; font-size: .93rem; }
+    th, td { padding: 14px 18px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
+    tr:last-child td { border-bottom: 0; }
+    th { background: var(--soft); color: var(--muted); font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; }
+    td:first-child { width: 38%; color: var(--blue-dark); font: .86rem ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: nowrap; }
+    tbody tr:hover { background: #fafbfe; }
+
+    .architecture {
+      display: grid;
+      grid-template-columns: 1fr 2fr;
+      gap: 34px;
+      align-items: start;
