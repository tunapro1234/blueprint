+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="description" content="blueprint orchestrates a fleet of AI agents in tmux.">
+  <title>blueprint (bp) — AI agent orchestration in tmux</title>
+  <style>
+    :root {
+      color-scheme: light;
+      --ink: #172033;
+      --muted: #647087;
+      --line: #dfe5ec;
+      --soft: #f5f7fa;
+      --paper: #ffffff;
+      --blue: #2459d3;
