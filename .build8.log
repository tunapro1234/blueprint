def load_offsets(handle: TextIO) -> dict[str, int]:
    handle.seek(0)
    raw = handle.read()
    if not raw.strip():
        return {}
    parsed = json.loads(raw)
    if not isinstance(parsed, dict):
        raise ValueError("offset state is not a JSON object")
    offsets: dict[str, int] = {}
    for path, value in parsed.items():
        if isinstance(path, str) and isinstance(value, int) and not isinstance(value, bool) and value >= 0:
            offsets[path] = value
    return offsets


def token_count(value: Any) -> int:
    if isinstance(value, bool):
        return 0
    if isinstance(value, int):
        return max(0, value)
    if isinstance(value, float) and value.is_integer():
        return max(0, int(value))
    return 0


def collect_token_deltas(offsets: dict[str, int]) -> tuple[dict[str, dict[str, int]], dict[str, int]]:
    totals: dict[str, dict[str, int]] = {}
    new_offsets = dict(offsets)

    try:
        transcripts = sorted(CLAUDE_PROJECTS.rglob("*.jsonl"))
    except Exception as error:
        report_error("transcript list failed", error)
        return totals, new_offsets

    for transcript in transcripts:
        path_key = str(transcript)
        try:
            size = transcript.stat().st_size
            offset = offsets.get(path_key, 0)
            if offset > size:
                offset = 0

            committed_offset = offset
            with transcript.open("rb") as handle:
                handle.seek(offset)
                while True:
                    line_start = handle.tell()
                    line = handle.readline()
                    if not line:
                        break
                    if not line.endswith(b"\n"):
                        committed_offset = line_start
                        break
                    committed_offset = handle.tell()
                    try:
                        entry = json.loads(line)
                    except (json.JSONDecodeError, UnicodeDecodeError) as error:
                        report_error(f"invalid transcript line in {transcript}", error)
                        continue

                    message = entry.get("message") if isinstance(entry, dict) else None
                    usage = message.get("usage") if isinstance(message, dict) else None
                    if not isinstance(usage, dict):
                        continue

                    # Nested subagent transcripts still belong to the project directory
                    # immediately below ~/.claude/projects.
                    project = transcript.relative_to(CLAUDE_PROJECTS).parts[0]
                    project_totals = totals.setdefault(
                        project,
                        {"in": 0, "out": 0, "cache_r": 0, "cache_w": 0},
                    )
                    project_totals["in"] += token_count(usage.get("input_tokens"))
                    project_totals["out"] += token_count(usage.get("output_tokens"))
                    project_totals["cache_r"] += token_count(
                        usage.get("cache_read_input_tokens")
                    )
                    project_totals["cache_w"] += token_count(
                        usage.get("cache_creation_input_tokens")
                    )
            new_offsets[path_key] = committed_offset
        except Exception as error:  # One damaged/unreadable transcript must not stop the rest.
            report_error(f"transcript read failed for {transcript}", error)

    return totals, new_offsets


def codex_project_label(cwd: str) -> str:
    """Encode a cwd the same way Claude names directories under projects/."""
    return cwd.replace("/", "-").replace(".", "-")


def codex_session_cwd(handle: Any) -> str | None:
    """Read a rollout's opening session metadata without changing its saved offset."""
    handle.seek(0)
    for _ in range(20):
        line = handle.readline()
        if not line:
            break
        try:
            entry = json.loads(line)
        except (json.JSONDecodeError, UnicodeDecodeError):
            continue
        if not isinstance(entry, dict) or entry.get("type") != "session_meta":
            continue
        payload = entry.get("payload")
        cwd = payload.get("cwd") if isinstance(payload, dict) else None
        return cwd if isinstance(cwd, str) and cwd else None
    return None


def collect_codex_token_deltas(
    offsets: dict[str, int],
) -> tuple[dict[str, dict[str, int]], dict[str, int]]:
    totals: dict[str, dict[str, int]] = {}
    new_offsets = dict(offsets)

    try:
        rollouts = sorted(CODEX_SESSIONS.rglob("*.jsonl"))
    except Exception as error:
        report_error("Codex rollout list failed", error)
        return totals, new_offsets

    for rollout in rollouts:
        path_key = str(rollout)
        try:
            size = rollout.stat().st_size
            offset = offsets.get(path_key, 0)
            if offset > size:
                offset = 0

            committed_offset = offset
            with rollout.open("rb") as handle:
                cwd = codex_session_cwd(handle)
                project = codex_project_label(cwd) if cwd is not None else None
                handle.seek(offset)
                while True:
                    line_start = handle.tell()
                    line = handle.readline()
                    if not line:
                        break
                    if not line.endswith(b"\n"):
                        committed_offset = line_start
                        break
                    committed_offset = handle.tell()
                    try:
                        entry = json.loads(line)
                    except (json.JSONDecodeError, UnicodeDecodeError) as error:
                        report_error(f"invalid Codex rollout line in {rollout}", error)
                        continue

                    payload = entry.get("payload") if isinstance(entry, dict) else None
                    if not isinstance(payload, dict) or payload.get("type") != "token_count":
                        continue
                    info = payload.get("info")
                    usage = info.get("last_token_usage") if isinstance(info, dict) else None
                    if not isinstance(usage, dict) or project is None:
                        continue

                    input_tokens = token_count(usage.get("input_tokens"))
                    output_tokens = token_count(usage.get("output_tokens"))
                    total_tokens = token_count(usage.get("total_tokens"))
                    if total_tokens == 0 and (input_tokens or output_tokens):
                        total_tokens = input_tokens + output_tokens

                    project_totals = totals.setdefault(
                        project,
                        {"in": 0, "out": 0, "total": 0},
                    )
                    project_totals["in"] += input_tokens
                    project_totals["out"] += output_tokens
                    project_totals["total"] += total_tokens
            new_offsets[path_key] = committed_offset
        except Exception as error:  # One damaged/unreadable rollout must not stop the rest.
            report_error(f"Codex rollout read failed for {rollout}", error)

    return totals, new_offsets


def save_offsets(handle: TextIO, offsets: dict[str, int]) -> None:
    handle.seek(0)
    handle.truncate()
    json.dump(offsets, handle, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    handle.write("\n")
    handle.flush()
    os.fsync(handle.fileno())


def collect_and_record_agents(ts: str) -> None:
    try:
        agents = tmux_agents()
    except Exception as error:
        report_error("tmux snapshot failed", error)
        agents = {}

    offset_handle: TextIO | None = None
    offsets: dict[str, int] = {}
    new_offsets: dict[str, int] = {}

