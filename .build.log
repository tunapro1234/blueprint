#!/usr/bin/env python3
# usage-watch — Claude/Codex usage-limit bekcisi (agent DEGIL, salt script; cron 10 dk'da bir)
# Ne yapar:
#  1) Acik tum tmux agent pane'lerini yoklar, usage-limit banner'i arar.
#  2) Limit yakalarsa "resets ..." zamanini parse eder, state'e yazar (bir kez loglar).
#  3) Reset zamani gecince server-main'e TEK mesaj atar: "limitler sifirlandi, sunlar
#     kesilmisti: ..." -> server-main kesilen agentlara isleri devam ettirmelerini soyler.
# Baska hicbir agent'a mesaj ATMAZ. State: /srv/server-main/usage/state.json
import json, os, re, subprocess, sys, time
from datetime import datetime, timedelta

DIR = "/srv/server-main/usage"
STATE = f"{DIR}/state.json"
LOG = f"{DIR}/watch.log"
SELF = "server-main"  # tetiklenecek orchestrator; kendisi izlenmez ama limitlenirse loglanir

os.makedirs(DIR, exist_ok=True)

def log(msg):
    line = f"[{datetime.now():%Y-%m-%d %H:%M:%S}] {msg}"
    with open(LOG, "a") as f: f.write(line + "\n")

def sh(cmd):
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    return r.stdout

def sessions():
    return [s for s in sh("tmux ls -F '#{session_name}' 2>/dev/null").split() if s]

# SPEND (para/kredi) limiti: zaman reset'i YOK — /usage-credits ya da model degistir gerekir.
# Bunu zaman-reset'li limitten AYIR; yoksa reset tetiklemesi yanlis olur.
SPEND_RE = re.compile(r"(?i)(spend limit|usage.?credits|billing limit|monthly.{0,20}limit|switch models to continue)")
# Zaman-reset'li limit (asil hedef): "usage limit reached ... resets at X"
LIMIT_RE = re.compile(r"(?i)(usage limit reached|limit reached|reached your.{0,20}limit|hit your.{0,20}limit|out of (usage|credits)|rate.?limited)")
RESET_RE = re.compile(r"(?i)(?:resets?|try again|available)(?:\s+at)?\s+([A-Za-z0-9: ]{2,30}?)(?:\s*[·∙|(\n]|$)")

def parse_reset(text, now):
    """'3am' '3:30pm' '19:00' 'Jul 10' 'Jul 10 at 9am' 'tomorrow at 3am' -> epoch; olmazsa now+1h"""
    m = RESET_RE.search(text)
    if not m: return int(now + 3600), "(parse yok, +1s)"
    raw = m.group(1).strip()
    s = raw.lower().replace("tomorrow at", "").replace("tomorrow", "").strip()
    dt = None
    nowdt = datetime.fromtimestamp(now)
    # saat kaliplari
    tm = re.match(r"^(\d{1,2})(?::(\d{2}))?\s*(am|pm)?$", s)
    if tm:
        h = int(tm.group(1)); mnt = int(tm.group(2) or 0); ap = tm.group(3)
        if ap == "pm" and h != 12: h += 12
        if ap == "am" and h == 12: h = 0
        dt = nowdt.replace(hour=h, minute=mnt, second=0, microsecond=0)
        if dt <= nowdt: dt += timedelta(days=1)
    else:
        # 'Jul 10' / 'Jul 10 at 9am'
        dm = re.match(r"^([a-z]{3,9})\s+(\d{1,2})(?:\s+at\s+(\d{1,2})(?::(\d{2}))?\s*(am|pm)?)?$", s)
        if dm:
            try:
                mon = datetime.strptime(dm.group(1)[:3], "%b").month
                h = int(dm.group(3) or 0); mnt = int(dm.group(4) or 0); ap = dm.group(5)
                if ap == "pm" and h != 12: h += 12
                if ap == "am" and h == 12: h = 0
                dt = nowdt.replace(month=mon, day=int(dm.group(2)), hour=h, minute=mnt, second=0, microsecond=0)
                if dt <= nowdt: dt = dt.replace(year=dt.year + 1)
            except ValueError: pass
    if dt is None: return int(now + 3600), f"'{raw}' (parse edilemedi, +1s)"
    return int(dt.timestamp()), raw

def notify_self(msg):
    # agent script'inin send_msg mantigi: literal metin + AYRI Enter (+ vim icin yedek Enter)
    subprocess.run(["tmux", "send-keys", "-t", SELF, "-l", msg])
    time.sleep(0.4)
    subprocess.run(["tmux", "send-keys", "-t", SELF, "Enter"])
    time.sleep(1.2)
    pane = sh(f"tmux capture-pane -t {SELF} -p")
    if msg[-40:] in pane and "esc to interrupt" not in pane.lower():
        subprocess.run(["tmux", "send-keys", "-t", SELF, "Enter"])

state = {"limited": {}}
if os.path.exists(STATE):
    try: state = json.load(open(STATE))
    except Exception: pass
limited = state.setdefault("limited", {})
now = time.time()

spend = state.setdefault("spend", {})   # spend-limit'e takilanlar (reset yok, tekrar uyarma)
spend_new = []

# 1) tara
for s in sessions():
    pane = sh(f"tmux capture-pane -t '{s}' -p 2>/dev/null")
    tail = "\n".join(pane.splitlines()[-25:])
    if SPEND_RE.search(tail):
        # PARA/kredi limiti: zaman reset'i YOK -> reset tetiklemesi YAPMA, bir kez bildir.
        limited.pop(s, None)
        if s not in spend:
            spend[s] = int(now)
            spend_new.append(s)
            log(f"SPEND LIMIT: {s} — aylik harcama/kredi limiti (zaman reset'i yok, model degistir/usage-credits)")
        continue
    else:
        spend.pop(s, None)  # spend banner'i kalkti
    if LIMIT_RE.search(tail):
        if s not in limited:
            reset_at, raw = parse_reset(tail, now)
            limited[s] = {"detected": int(now), "reset_at": reset_at, "reset_raw": raw}
            log(f"LIMIT: {s} — reset: {raw} -> {datetime.fromtimestamp(reset_at):%Y-%m-%d %H:%M}")
    else:
        if s in limited and limited[s].get("reset_at", 0) > now:
            # banner kayboldu (kullanici devam ettirmis olabilir) — erken temizle
            log(f"TEMIZ (banner yok): {s}")
            del limited[s]

# 2) reset zamani gecenler -> server-main'i tek mesajla tetikle
due = [s for s, v in limited.items() if v["reset_at"] <= now]
if due:
    others = [s for s in due if s != SELF]
    lst = ", ".join(due)
    log(f"RESET GECTI -> server-main tetikleniyor: {lst}")
    if others or SELF in due:
        notify_self(
            f"[usage-watch script] Usage limitleri sifirlanmis olmali (reset zamani gecti). "
            f"Kesilmis agentlar: {lst}. Bu agentlara islerine kaldiklari yerden devam "
            f"etmelerini soyle (agent msg <ad> ...). Detay log: /srv/server-main/usage/watch.log")
    for s in due: del limited[s]

# 3) spend-limit'e YENI takilanlari server-main'e bir kez bildir (reset degil, aksiyon gerek)
if spend_new:
    lst = ", ".join(spend_new)
    notify_self(
        f"[usage-watch script] SPEND/harcama limiti (zaman reset'i YOK): {lst}. "
        f"Bu agentlar Fable aylik harcama limitine takildi — 'devam et' ise yaramaz; "
        f"/model ile baska modele gecir ya da agent'i kapat. Detay: /srv/server-main/usage/watch.log")

# temiz oturumlari state'ten dus (kapanan agentlar birikmesin)
alive = set(sessions())
for d in (limited, spend):
    for k in [k for k in d if k not in alive]:
        del d[k]

json.dump(state, open(STATE, "w"), indent=1)

