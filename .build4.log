--- a/site/install.sh
+++ b/site/install.sh
@@ -3,7 +3,16 @@
 
 SERVER_ROOT=/srv/blueprint
 INSTALL_MODE=${BP_INSTALL_MODE:-}
+YES=${BP_YES:-0}
 
+while [ "$#" -gt 0 ]; do
+    case "$1" in
+        --yes|-y) YES=1 ;;
+        *) printf 'error: unknown option: %s\n' "$1" >&2; exit 1 ;;
+    esac
