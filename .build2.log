+// IsDescendant reports whether name is below ancestor in the agentbook parent chain.
+func (f Fleet) IsDescendant(name, ancestor string) bool {
+	seen := map[string]bool{}
+	for name != "" && !seen[name] {
+		seen[name] = true
+		name = f.Parents[name]
+		if name == ancestor {
+			return true
+		}
+	}
+	return false
+}
