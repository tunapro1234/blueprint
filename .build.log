def print_status(summary: dict[str, Any]) -> int:
    errors: list[str] = summary["errors"]
    mode = load_mode(errors)
    state = load_state(errors)
    now = utc_now()
    metrics: dict[str, Any] | None = None
    freshness = "unavailable"
    candidate = "unavailable"
    try:
        record = last_history_record()
        metrics = metrics_from_history(record, now)
        freshness = f"fresh ({int(metrics['age_seconds'])}s)"
        candidate = candidate_state(metrics)
    except RuntimeError as error:
        freshness = str(error)
    except Exception as error:
        errors.append(f"history:{error}")
    until = parse_time(state.get("override_until"))
    override_text = state.get("override_until") if until and until > now else "-"
    print(f"mode: {mode}")
    print(f"state: {state['state']}")
    print(f"pending: {state['pending'] or '-'} ({state['pending_count']}/2)")
    print(f"candidate: {candidate}")
    print(f"last_change: {state['last_change'] or '-'}")
    print(f"override_until: {override_text}")
    if metrics is None:
        print(f"usage: {freshness}")
    else:
        print(
            "usage: "
            f"7g %{fmt(metrics['claude_7d'])}, "
            f"fable %{fmt(metrics['claude_fable_7d'])}, "
            f"5s %{fmt(metrics['claude_5h'])}, "
            f"reset {fmt(metrics['reset_hours'])}s, "
            f"E %{fmt(metrics['expected'])}, {freshness}"
        )
    applied = state.get("applied") if isinstance(state.get("applied"), dict) else {}
    print(f"applied_agents: {len(applied)}")
    if errors:
        print("warnings: " + "; ".join(errors))
    summary.update(
        {
            "mode": mode,
            "state": state["state"],
            "candidate": candidate,
            "result": "status",
            "freshness": freshness,
        }
    )
    return 0


def set_override(raw_hours: str, summary: dict[str, Any]) -> int:
    errors: list[str] = summary["errors"]
    try:
        hours = float(raw_hours)
        if not math.isfinite(hours) or hours < 0:
            raise ValueError
    except ValueError:
        print("kullanim: usage-policy override <saat>  (0 = kaldir)", file=sys.stderr)
        summary["result"] = "invalid-override"
        return 0
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        state = load_state(errors)
        state["override_until"] = None if hours == 0 else iso(utc_now() + timedelta(hours=hours))
        state["pending"] = None
        state["pending_count"] = 0
        save_state(state)
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
    if hours == 0:
        print("override kaldirildi")
    else:
        print(f"override_until: {state['override_until']}")
    summary.update(
        {
            "result": "override-set" if hours else "override-cleared",
            "override_until": state["override_until"],
            "state": state["state"],
        }
    )
    return 0


def main(argv: list[str], summary: dict[str, Any]) -> int:
    if not argv:
        summary["command"] = "run"
        return run_engine(summary)
    if argv == ["status"]:
        summary["command"] = "status"
        return print_status(summary)
    if len(argv) == 2 and argv[0] == "override":
        summary["command"] = "override"
        return set_override(argv[1], summary)
    summary["command"] = "invalid"
    summary["result"] = "usage"
    print("kullanim: usage-policy [status | override <saat>]", file=sys.stderr)
    return 0


if __name__ == "__main__":
    run_summary: dict[str, Any] = {"ts": iso(), "command": None, "result": None, "errors": []}
    exit_code = 0
    try:
        exit_code = main(sys.argv[1:], run_summary)
    except Exception as error:
        run_summary["result"] = "error"
        run_summary["errors"].append(f"unexpected:{type(error).__name__}:{error}")
        print(f"usage-policy: {error}", file=sys.stderr)
        exit_code = 0
    finally:
        append_log(run_summary)
    raise SystemExit(exit_code)
    if parsed.tzinfo is None:
        raise ValueError(f"{context}: timestamp has no UTC offset: {value!r}")
    return parsed


def require_number(value: Any, *, context: str) -> int | float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ValueError(f"{context}: expected a number")
    if not math.isfinite(value):
        raise ValueError(f"{context}: expected a finite number")
    return value


def usage_history(history_rows: list[dict[str, Any]]) -> dict[str, Any]:
    normalized: list[dict[str, Any]] = []
    for index, row in enumerate(history_rows, 1):
        context = f"{HISTORY_PATH}:{index}"
        ts = row.get("ts")
        parse_iso(ts, context=f"{context}.ts")
        item = {
            "ts": ts,
            "claude_5h": require_number(row.get("claude_5h"), context=f"{context}.claude_5h"),
            "claude_7d": require_number(row.get("claude_7d"), context=f"{context}.claude_7d"),
            "claude_fable_7d": None,
            "codex_5h": require_number(row.get("codex_5h"), context=f"{context}.codex_5h"),
            "codex_7d": require_number(row.get("codex_7d"), context=f"{context}.codex_7d"),
        }
        if row.get("claude_fable_7d") is not None:
            item["claude_fable_7d"] = require_number(
                row["claude_fable_7d"], context=f"{context}.claude_fable_7d"
            )
        normalized.append(item)

    # The contract explicitly defines current as the source file's final row.
    last_source = history_rows[-1]
    last_item = normalized[-1]
    claude_resets = last_source.get("claude_resets")
    codex_resets = last_source.get("codex_resets")
    if not isinstance(claude_resets, dict) or not isinstance(codex_resets, dict):
        raise ValueError(f"{HISTORY_PATH}: final row has invalid reset objects")
    resets = {
        "claude_5h": claude_resets.get("5h"),
        "claude_7d": claude_resets.get("7d"),
        "codex_5h": codex_resets.get("5h"),
        "codex_7d": codex_resets.get("7d"),
    }
    # Reset ANINDA kaynak null yazabiliyor (ör. 5h penceresi tam dönerken) —
    # bu ölümcül değil: değer null kalır, UI "—" gösterir; pulse zinciri düşmez.
    for key, value in list(resets.items()):
        if value is None or (isinstance(value, str) and not value.strip()):
            resets[key] = None
            continue
        parse_iso(value, context=f"{HISTORY_PATH}:final.resets.{key}")

    current = dict(last_item)
    current["resets"] = resets
    normalized.sort(key=lambda item: parse_iso(item["ts"], context="history.ts"))
    return {"current": current, "history": normalized}


def token_series(agent_rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
    series: list[dict[str, Any]] = []
    # Row zero is a historical cumulative snapshot, not a ten-minute delta.
    for row_index, row in enumerate(agent_rows[1:], 2):
        ts = row.get("ts")
        parse_iso(ts, context=f"{AGENTS_PATH}:{row_index}.ts")
        source_projects = row.get("tokens")
        if not isinstance(source_projects, dict):
            raise ValueError(f"{AGENTS_PATH}:{row_index}.tokens must be an object")
        projects: dict[str, dict[str, int | float]] = {}
        for project, source_counts in source_projects.items():
            if not isinstance(project, str) or not isinstance(source_counts, dict):
                raise ValueError(f"{AGENTS_PATH}:{row_index}.tokens has an invalid project")
            counts: dict[str, int | float] = {}
            for field in TOKEN_FIELDS:
                counts[field] = require_number(
                    source_counts.get(field),
                    context=f"{AGENTS_PATH}:{row_index}.tokens.{project}.{field}",
                )
            projects[project] = counts
        series.append({"ts": ts, "projects": projects})
    series.sort(key=lambda item: parse_iso(item["ts"], context="tokens.series.ts"))
    return series


def is_wildcard_agent(name: Any) -> bool:
    return not isinstance(name, str) or not name or any(char in name for char in "*?[")


def build_agent_tree(
    server_book: dict[str, Any], probot_book: dict[str, Any], final_agent_row: dict[str, Any]
) -> dict[str, Any]:
    nodes: dict[str, dict[str, Any]] = {}
    parents: dict[str, str | None] = {}
    order: list[str] = []

    def merge_agent(source: dict[str, Any], parent: str | None) -> None:
        name = source.get("name")
        if is_wildcard_agent(name):
            return
        assert isinstance(name, str)
        if name not in nodes:
            nodes[name] = {
                "name": name,
                "nickname": None,
                "role": None,
                "status": None,
                "state": "unknown",
                "children": [],
            }
            order.append(name)
        node = nodes[name]
        nickname = source.get("nickname")
        role = source.get("role")
        status = source.get("status")
        if isinstance(nickname, str) and nickname:
            node["nickname"] = nickname
        if isinstance(role, str):
            node["role"] = role
        if status in {"open", "on-demand", "closed"}:
            node["status"] = status
        parents[name] = parent

    server_agents = server_book.get("agents")
    probot_agents = probot_book.get("agents")
    if not isinstance(server_agents, list) or not isinstance(probot_agents, list):
        raise ValueError("agentbook agents fields must be arrays")

    server_root = server_book.get("orchestrator", "server-main")
    if not isinstance(server_root, str) or not server_root:
        raise ValueError(f"{SERVER_BOOK_PATH}: invalid orchestrator")
#!/usr/bin/env python3
"""Detect new flagship-provider models and maintain models.json/radar.json."""

from __future__ import annotations

import hashlib
import html
import json
import re
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from html.parser import HTMLParser
from pathlib import Path
from typing import Any

from common import STATE_DIR, Logger, atomic_json, iso, load_json, rebuild_radar, send_wa, state_lock, utc_now


LOG = Logger("model_watch")
STATE_PATH = STATE_DIR / "models.json"
OPENROUTER_URL = "https://openrouter.ai/api/v1/models"
NEWS_SOURCES = {
    "anthropic": "https://www.anthropic.com/news",
    "openai": "https://openai.com/news/rss.xml",
    "google": "https://blog.google/technology/ai/rss/",
    "x-ai": "https://x.ai/news",
}
PROVIDER_LABELS = {"anthropic": "Anthropic", "openai": "OpenAI", "google": "Google", "x-ai": "xAI"}
USER_AGENT = "server-monitor-model-radar/1.0"


class HeadlineParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.depth = 0
        self.parts: list[str] = []
        self.items: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in {"h1", "h2", "h3", "a"}:
            if self.depth == 0:
                self.parts = []
            self.depth += 1

    def handle_endtag(self, tag: str) -> None:
        if tag in {"h1", "h2", "h3", "a"} and self.depth:
            self.depth -= 1
            if self.depth == 0:
                text = re.sub(r"\s+", " ", html.unescape(" ".join(self.parts))).strip()
                if 4 <= len(text) <= 240:
                    self.items.append(text)

    def handle_data(self, data: str) -> None:
        if self.depth:
            self.parts.append(data)


MODEL_PATTERNS = {
    "anthropic": [
        re.compile(r"\bClaude\s+(?:\d+(?:\.\d+)?\s+)?(?:Opus|Sonnet|Haiku)(?:\s+\d+(?:\.\d+)?)?\b", re.I),
        re.compile(r"\bClaude\s+\d+(?:\.\d+)?\b", re.I),
    ],
    "openai": [
        re.compile(r"\bGPT[-\s]?\d+(?:\.\d+)?(?:[-\s][A-Za-z0-9]+){0,3}\b", re.I),
        re.compile(r"\bo[1-9](?:[-\s](?:mini|pro|preview)){0,2}\b", re.I),
    ],
    "google": [
        re.compile(r"\bGemini\s+\d+(?:\.\d+)?(?:\s+(?:Pro|Flash|Ultra|Nano|Deep Think)){0,2}\b", re.I),
        re.compile(r"\bGemma\s+\d+(?:\.\d+)?\b", re.I),
    ],
    "x-ai": [re.compile(r"\bGrok\s*[- ]?\d+(?:\.\d+)?(?:[- ](?:mini|fast|beta)){0,2}\b", re.I)],
}


def fetch(url: str) -> bytes | None:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json, application/rss+xml, text/html;q=0.9"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.read(5_000_000)
    except (OSError, urllib.error.URLError, TimeoutError) as exc:
        LOG(f"kaynak hatası url={url}: {exc}")
        return None


def provider_for(model_id: str) -> str | None:
    prefix = model_id.split("/", 1)[0].lower()
    if prefix in {"anthropic", "openai", "google", "x-ai"}:
        return prefix
    if prefix == "grok":
        return "x-ai"
    return None


def canonical_model(provider: str, model: str) -> str:
    value = model.lower().strip()
    if "/" in value:
        value = value.split("/", 1)[1]
    value = value.replace("_", "-").replace(" ", "-")
    value = re.sub(r":(?:free|extended|online)$", "", value)
    value = re.sub(r"-(?:latest|preview|beta)$", "", value)
    value = re.sub(r"-(?:20\d{2})[-.]?(?:0[1-9]|1[0-2])[-.]?(?:0[1-9]|[12]\d|3[01])$", "", value)
    value = re.sub(r"-+", "-", value).strip("-")
    return f"{provider}:{value}"


def openrouter_models() -> list[dict[str, Any]] | None:
    raw = fetch(OPENROUTER_URL)
    if raw is None:
        return None
    try:
        data = json.loads(raw)
        rows = data.get("data", [])
    except (json.JSONDecodeError, AttributeError) as exc:
        LOG(f"OpenRouter JSON hatası: {exc}")
        return None
    result = []
    for row in rows:
        if not isinstance(row, dict) or not isinstance(row.get("id"), str):
            continue
        provider = provider_for(row["id"])
        if provider:
            result.append({"id": row["id"], "provider": provider, "created": row.get("created")})
    return result


def news_items(provider: str, url: str) -> list[tuple[str, list[str]]] | None:
    raw = fetch(url)
    if raw is None:
        return None
    texts: list[str] = []
    try:
        root = ET.fromstring(raw)
        for node in root.iter():
            if node.tag.rsplit("}", 1)[-1].lower() == "title" and node.text:
                texts.append(re.sub(r"\s+", " ", html.unescape(node.text)).strip())
    except ET.ParseError:
        parser = HeadlineParser()
        try:
            parser.feed(raw.decode("utf-8", "replace"))
            texts.extend(parser.items)
        except Exception as exc:
            LOG(f"haber HTML ayrıştırma hatası provider={provider}: {exc}")
            return None
    found: list[tuple[str, list[str]]] = []
    seen = set()
    for text in texts:
        models: list[str] = []
        for pattern in MODEL_PATTERNS[provider]:
            models.extend(match.group(0).strip(" .,:;–—") for match in pattern.finditer(text))
        models = list(dict.fromkeys(models))
        if not models:
            continue
        fingerprint = hashlib.sha256(f"{provider}\0{text}".encode()).hexdigest()[:24]
        if fingerprint not in seen:
            seen.add(fingerprint)
            found.append((fingerprint, models))
    return found


def event_id(provider: str, roots: list[str], timestamp: str) -> str:
    digest = hashlib.sha256((provider + "\0" + "\0".join(sorted(roots)) + "\0" + timestamp).encode()).hexdigest()[:16]
    return f"model-{digest}"


def default_state() -> dict[str, Any]:
    return {
        "version": 1,
        "source_initialized": {},
        "seen_model_ids": [],
        "seen_roots": [],
        "seen_news": {},
        "events": [],
        "channels": {},
        "last_model_watch": "1970-01-01T00:00:00Z",
        "last_reactions": "1970-01-01T00:00:00Z",
    }


def main() -> int:
#!/usr/bin/env python3
"""Collect YouTube reactions and parameter rumors for due model events."""

from __future__ import annotations

import html
import json
import os
import re
import subprocess
import tempfile
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path
from typing import Any

from common import STATE_DIR, WATCH_DIR, Logger, atomic_json, iso, load_json, parse_iso, rebuild_radar, send_wa, state_lock, utc_now


LOG = Logger("reactions")
STATE_PATH = STATE_DIR / "models.json"
CHANNEL_NAMES = ("Theo", "Wes Roth", "WorldofAI")
CHANNEL_ID_RE = re.compile(r"^UC[A-Za-z0-9_-]{22}$")
USER_AGENT = "server-monitor-model-radar/1.0"
CODEX_MODELS = {"sol": "gpt-5.6-sol", "terra": "gpt-5.6-terra", "luna": "gpt-5.6-luna"}


def run_codex(prompt: str, model: str, effort: str, search: bool, timeout: int = 180) -> str | None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd, output_name = tempfile.mkstemp(prefix="codex-result-", suffix=".txt", dir=STATE_DIR)
    os.close(fd)
    output_path = Path(output_name)
    resolved_model = CODEX_MODELS.get(model, model)
    command = ["/usr/bin/codex"]
    if search:
        command.append("--search")
    command.extend([
        "exec", "--ephemeral", "--skip-git-repo-check", "--color", "never",
        "-s", "read-only", "-C", str(WATCH_DIR), "-m", resolved_model,
        "-c", f'model_reasoning_effort="{effort}"', "-o", str(output_path), "-",
    ])
    env = os.environ.copy()
    env.setdefault("HOME", "/root")
    try:
        result = subprocess.run(command, input=prompt, text=True, capture_output=True, timeout=timeout, check=False, env=env)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip().replace("\n", " ")[-500:]
            LOG(f"codex hata model={resolved_model} search={int(search)} rc={result.returncode}: {detail}")
            return None
        try:
            answer = output_path.read_text(encoding="utf-8").strip()
        except OSError:
            answer = result.stdout.strip()
        return answer or None
    except (OSError, subprocess.TimeoutExpired) as exc:
        LOG(f"codex timeout/çalıştırma hatası model={resolved_model} search={int(search)}: {exc}")
        return None
    finally:
        try:
            output_path.unlink()
        except FileNotFoundError:
            pass


def extract_json_object(text: str) -> dict[str, Any] | None:
    decoder = json.JSONDecoder()
    for index, char in enumerate(text):
        if char != "{":
            continue
        try:
            value, _ = decoder.raw_decode(text[index:])
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            return value
    return None


def discover_channels() -> dict[str, dict[str, str]]:
    prompt = """Web aramasıyla aşağıdaki resmi YouTube kanallarının channel_id değerlerini doğrula:
- Theo / t3.gg
- Wes Roth
- WorldofAI
Yalnızca şu biçimde JSON döndür; açıklama/markdown ekleme:
{"Theo":"UC...","Wes Roth":"UC...","WorldofAI":"UC..."}
Her ID 24 karakterli ve UC ile başlayan gerçek YouTube channel_id olmalı. Emin olmadığını boş string bırak; tahmin etme."""
    answer = run_codex(prompt, "sol", "high", search=True)
    if not answer:
        LOG("kanal ID keşfi başarısız: codex --search yanıt vermedi; ID hardcode edilmedi")
        return {}
    parsed = extract_json_object(answer)
    if not parsed:
        LOG("kanal ID keşfi başarısız: codex --search geçerli JSON döndürmedi; ID hardcode edilmedi")
        return {}
    found: dict[str, dict[str, str]] = {}
    for name in CHANNEL_NAMES:
        channel_id = str(parsed.get(name, "")).strip()
        if CHANNEL_ID_RE.fullmatch(channel_id):
            found[name] = {"channel_id": channel_id, "discovered_at": iso(), "method": "codex --search"}
