+def codex_project_label(cwd: str) -> str:
+    """Encode a cwd the same way Claude names directories under projects/."""
+    return cwd.replace("/", "-").replace(".", "-")
+
+
+def codex_session_cwd(handle: Any) -> str | None:
+    """Read a rollout's opening session metadata without changing its saved offset."""
+    handle.seek(0)
+    for _ in range(20):
+        line = handle.readline()
+        if not line:
+            break
+        try:
+            entry = json.loads(line)
+        except (json.JSONDecodeError, UnicodeDecodeError):
+            continue
+        if not isinstance(entry, dict) or entry.get("type") != "session_meta":
+            continue
+        payload = entry.get("payload")
+        cwd = payload.get("cwd") if isinstance(payload, dict) else None
+        return cwd if isinstance(cwd, str) and cwd else None
+    return None
+
+
+def collect_codex_token_deltas(
+    offsets: dict[str, int],
+) -> tuple[dict[str, dict[str, int]], dict[str, int]]:
+    totals: dict[str, dict[str, int]] = {}
+    new_offsets = dict(offsets)
+
+    try:
+        rollouts = sorted(CODEX_SESSIONS.rglob("*.jsonl"))
+    except Exception as error:
+        report_error("Codex rollout list failed", error)
+        return totals, new_offsets
+
+    for rollout in rollouts:
+        path_key = str(rollout)
+        try:
+            size = rollout.stat().st_size
+            offset = offsets.get(path_key, 0)
+            if offset > size:
+                offset = 0
+
+            committed_offset = offset
+            with rollout.open("rb") as handle:
+                cwd = codex_session_cwd(handle)
+                project = codex_project_label(cwd) if cwd is not None else None
+                handle.seek(offset)
+                while True:
+                    line_start = handle.tell()
+                    line = handle.readline()
+                    if not line:
+                        break
+                    if not line.endswith(b"\n"):
+                        committed_offset = line_start
+                        break
+                    committed_offset = handle.tell()
+                    try:
+                        entry = json.loads(line)
+                    except (json.JSONDecodeError, UnicodeDecodeError) as error:
+                        report_error(f"invalid Codex rollout line in {rollout}", error)
+                        continue
+
+                    payload = entry.get("payload") if isinstance(entry, dict) else None
+                    if not isinstance(payload, dict) or payload.get("type") != "token_count":
+                        continue
+                    info = payload.get("info")
+                    usage = info.get("last_token_usage") if isinstance(info, dict) else None
+                    if not isinstance(usage, dict) or project is None:
+                        continue
+
+                    input_tokens = token_count(usage.get("input_tokens"))
+                    output_tokens = token_count(usage.get("output_tokens"))
+                    total_tokens = token_count(usage.get("total_tokens"))
+                    if total_tokens == 0 and (input_tokens or output_tokens):
+                        total_tokens = input_tokens + output_tokens
+
+                    project_totals = totals.setdefault(
+                        project,
+                        {"in": 0, "out": 0, "total": 0},
+                    )
+                    project_totals["in"] += input_tokens
+                    project_totals["out"] += output_tokens
+                    project_totals["total"] += total_tokens
+            new_offsets[path_key] = committed_offset
+        except Exception as error:  # One damaged/unreadable rollout must not stop the rest.
+            report_error(f"Codex rollout read failed for {rollout}", error)
+
+    return totals, new_offsets
+
+
 def save_offsets(handle: TextIO, offsets: dict[str, int]) -> None:
     handle.seek(0)
     handle.truncate()
