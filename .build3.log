+  <meta name="description" content="blueprint orchestrates a fleet of AI agents in tmux.">
+  <title>blueprint (bp) — AI agent orchestration in tmux</title>
+  <style>
+    :root {
+      color-scheme: light;
+      --ink: #172033;
+      --muted: #647087;
+      --line: #dfe5ec;
+      --soft: #f5f7fa;
+      --paper: #ffffff;
+      --blue: #2459d3;
+      --blue-dark: #153f9b;
+      --code: #101827;
+      --code-ink: #e8edf5;
+      --radius: 14px;
+    }
+
+    * { box-sizing: border-box; }
+
+    html { scroll-behavior: smooth; }
+
+    body {
+      margin: 0;
+      background: var(--paper);
+      color: var(--ink);
+      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+      font-size: 16px;
+      line-height: 1.65;
+      text-rendering: optimizeLegibility;
+    }
+
+    a { color: var(--blue); }
+
+    .shell {
+      width: min(100% - 40px, 1040px);
+      margin: 0 auto;
+    }
+
+    header {
+      border-bottom: 1px solid var(--line);
+      background:
+        radial-gradient(circle at 80% 20%, rgba(36, 89, 211, .10), transparent 34%),
+        linear-gradient(180deg, #fbfcff 0%, #fff 100%);
+    }
+
+    nav {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      min-height: 68px;
+    }
+
+    .brand {
+      color: var(--ink);
+      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+      font-weight: 750;
+      letter-spacing: -.04em;
+      text-decoration: none;
+    }
+
+    .nav-links { display: flex; gap: 22px; }
+    .nav-links a { color: var(--muted); font-size: .9rem; text-decoration: none; }
+    .nav-links a:hover { color: var(--ink); }
+
+    .hero { padding: 92px 0 96px; }
+
+    .eyebrow,
+    h2 {
+      color: var(--blue);
+      font-size: .76rem;
+      font-weight: 800;
+      letter-spacing: .13em;
+      text-transform: uppercase;
+    }
+
+    h1 {
+      max-width: 850px;
