+      font-size: clamp(2.35rem, 7vw, 5.1rem);
+      font-weight: 760;
+      letter-spacing: -.065em;
+      line-height: 1.02;
+    }
+
+    h1 span { color: var(--muted); font-weight: 570; }
+
+    .lede {
+      max-width: 680px;
+      margin: 0 0 34px;
+      color: var(--muted);
