+  "license": "UNLICENSED",
+  "repository": {
+    "type": "git",
+    "url": "git+https://github.com/tunapro1234/blueprint.git"
+  },
+  "homepage": "https://bp.trasumanar.ai",
+  "bin": {
+    "bp": "bin/bp.js"
