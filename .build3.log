+    tr:last-child td { border-bottom: 0; }
+    th { background: var(--soft); color: var(--muted); font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; }
+    td:first-child { width: 38%; color: var(--blue-dark); font: .86rem ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: nowrap; }
