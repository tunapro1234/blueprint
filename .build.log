#!/usr/bin/env bash
# agent — server-main orchestration araci (tek dosya, bloat yok)
# Kullanim:
#   agent status                          filo ozeti (tmux + agentbook karsilastirmali)
#   agent peek <ad> [N]                   pane'in son N satiri (default 8)
#   agent msg  <ad> <mesaj...>            mesaj gonder; hedef doluysa KANALa kuyruklar (bosalinca gider + haber)
#   agent q                               bekleyen mesaj kuyrugu
#   agent qstat <kanal-id>                kuyruklanan mesajin durumu (bekliyor/iletildi/iptal)
#   agent qflush                          kuyrugu dagit (systemd timer cagirir)
#   agent open <ad> <klasor> [--resume] [--no-prompt]   ac: claude(+resume full) + /rename + /remote-control + onboarding + agentbook
#   agent close <ad>                      kapat + agentbook status=closed
# Env: AGENTBOOK=<json>  (default /srv/server-main/agentbook.json; kitap-main kendi book'uyla kullanabilir)
set -u
BOOK="${AGENTBOOK:-/srv/server-main/agentbook.json}"
busy(){ tmux capture-pane -t "$1" -p 2>/dev/null | grep -qiE 'esc to interrupt'; }
alive(){ tmux has-session -t "$1" 2>/dev/null; }

book_set(){ # book_set <ad> <status> [folder]
  python3 - "$BOOK" "$1" "$2" "${3:-}" <<'PY'
import json,sys,datetime
book,name,status,folder=sys.argv[1:5]
d=json.load(open(book))
for a in d["agents"]:
    if a.get("name")==name:
        a["status"]=status; break
else:
    d["agents"].append({"name":name,"folder":folder,"class":"other","role":"(yeni - rol gir)","status":status})
d["updated"]=datetime.date.today().isoformat()
json.dump(d,open(book,"w"),ensure_ascii=False,indent=2)
PY
}

typing(){ # hedefin CANLI input satirinda yazi var mi? (biri - belki KULLANICI - yaziyor)
  # SADECE SON '❯' satirina bak (canli composer). Tum pane'i taramak eski user-turn'leri
  # ('❯ <metin>' diye render edilir) yakalayip FALSE-POSITIVE veriyordu (alp bug raporu, 2026-07-10).
  local line
  line=$(tmux capture-pane -t "$1" -p 2>/dev/null | grep -E '^\s*❯' | tail -1)
  line="${line#*❯}"
  # NBSP (C2A0) + tum bosluklari sil; kalan varsa yaziliyor demektir
  line=$(printf '%s' "$line" | sed -e 's/\xc2\xa0//g' -e 's/[[:space:]]//g')
  [ -n "$line" ]
}
QDIR=/srv/server-main/msgq/pending
QDONE=/srv/server-main/msgq/done
sender(){ echo "${AGENT:-$(tmux display-message -p '#S' 2>/dev/null || echo server-main)}"; }
enqueue(){ # enqueue <to> <from> <msg>  -> kanal id basar
  mkdir -p "$QDIR"
  local id="q$(date +%s%N | tail -c 10)"
  python3 -c 'import json,sys,time
json.dump({"id":sys.argv[1],"to":sys.argv[2],"from":sys.argv[3],"msg":sys.argv[4],"ts":time.time()}, open(sys.argv[5],"w"), ensure_ascii=False)' \
    "$id" "$1" "$2" "$3" "$QDIR/$id.json"
  echo "$id"
}
qfinish(){ # qfinish <pendingfile> <id> <durum>  — teslim kaydini done'a tasi (qstat icin)
  mkdir -p "$QDONE"
  python3 -c 'import json,sys,time
d=json.load(open(sys.argv[1])); d["durum"]=sys.argv[2]; d["bitis"]=time.time()
json.dump(d, open(sys.argv[3],"w"), ensure_ascii=False)' "$1" "$3" "$QDONE/$2.json"
  rm -f "$1"
}
send_msg(){ # send_msg <ad> <mesaj>  — hedef BOS varsayilir (kontrol cagiranin isi); literal gonder + submit dogrula
  local s="$1" m="$2"
  # son-saniye emniyeti: yazi belirdiyse gonderme
  typing "$s" && return 2
  if [[ "$m" == *$'\n'* ]]; then
    printf '%s' "$m" | tmux load-buffer -b agentmsg - && tmux paste-buffer -b agentmsg -d -t "$s"
  else
    tmux send-keys -t "$s" -l "$m"
  fi
  sleep 0.4; tmux send-keys -t "$s" Enter; sleep 1.2
  # submit olmadiysa (busy degil ve input hala dolu) bir Enter daha
  if ! busy "$s" && tmux capture-pane -t "$s" -p | grep -qF "$(printf '%s' "$m" | tail -c 40)"; then
    tmux send-keys -t "$s" Enter
  fi
}

cmd="${1:-status}"; shift || true
case "$cmd" in
status)
  printf '%-24s %-10s %s\n' "AGENT" "TMUX" "AGENTBOOK"
  { tmux ls -F '#{session_name}' 2>/dev/null; python3 -c 'import json,sys;[print(a["name"]) for a in json.load(open(sys.argv[1]))["agents"] if "name" in a and " " not in a["name"]]' "$BOOK"; } | sort -u | while read -r s; do
    if alive "$s"; then t=$(busy "$s" && echo "CALISIYOR" || echo "bosta"); else t="-"; fi
    b=$(python3 -c 'import json,sys
for a in json.load(open(sys.argv[1]))["agents"]:
    if a.get("name")==sys.argv[2]: print(a.get("status","?")); break
else: print("kayitsiz")' "$BOOK" "$s")
    flag=""
    [ "$t" = "-" ] && [ "$b" = "open" ] && flag="  <-- book:open ama tmux YOK"
    [ "$t" != "-" ] && [ "$b" = "closed" ] && flag="  <-- tmux acik ama book:closed"
    printf '%-24s %-10s %-10s%s\n' "$s" "$t" "$b" "$flag"
  done ;;
peek)
  tmux capture-pane -t "${1:?ad}" -p | grep -v '^[[:space:]]*$' | tail -"${2:-8}" ;;
msg)
  s="${1:?ad}"; shift; m="$*"
  alive "$s" || { echo "HATA: $s diye acik oturum yok"; exit 1; }
  frm=$(sender)
  if typing "$s" || busy "$s"; then
    id=$(enqueue "$s" "$frm" "$m")
    echo "MESGUL: kuyruga alindi (kanal: $id)."
    echo "$s bosalinca otomatik gonderilecek. Teslim kontrolu (istedigin zaman):"
    echo "  /srv/server-main/bin/agent qstat $id"
    echo "(bekliyor / iletildi / iptal doner. Bildirim GELMEZ - merak edersen bakarsin.)"
  else
    if send_msg "$s" "$m"; then echo "gonderildi"
    else
      id=$(enqueue "$s" "$frm" "$m")
      echo "son anda doldu -> kuyruga alindi (kanal: $id). Kontrol: agent qstat $id"
    fi
  fi ;;
q)
  ls "$QDIR"/*.json 2>/dev/null | while read -r f; do
    python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print(d["id"],d["from"],"->",d["to"],":",d["msg"][:60])' "$f"
  done
  [ -z "$(ls -A "$QDIR" 2>/dev/null)" ] && echo "(kuyruk bos)" ;;
qstat)
  id="${1:?kanal id}"
  if [ -f "$QDIR/$id.json" ]; then
    python3 -c 'import json,sys,time
d=json.load(open(sys.argv[1]))
print("BEKLIYOR: " + d["to"] + " hala musait degil (" + str(int(time.time()-d["ts"])) + " sn kuyrukta)")' "$QDIR/$id.json"
  elif [ -f "$QDONE/$id.json" ]; then
    python3 -c 'import json,sys,datetime
d=json.load(open(sys.argv[1]))
t=datetime.datetime.fromtimestamp(d["bitis"]).strftime("%H:%M")
print(d["durum"].upper() + ": " + d["to"] + " (saat " + t + ")")' "$QDONE/$id.json"
  else
    echo "BILINMIYOR: $id kayitlarda yok (2 gunden eski kayitlar silinir)"
  fi ;;
qflush)
  # dispatcher: bekleyenleri hedefe teslim et (systemd timer cagirir). GONDERENE MESAJ ATMAZ -
  # teslim kaydi done/'a duser, gonderen 'agent qstat <id>' ile kendisi bakar (kesme riski sifir).
  for f in $(ls "$QDIR"/*.json 2>/dev/null | sort); do
    eval "$(python3 -c 'import json,sys,shlex
d=json.load(open(sys.argv[1]))
print("qid=%s qto=%s qmsg=%s" % (shlex.quote(d["id"]),shlex.quote(d["to"]),shlex.quote(d["msg"])))' "$f")"
    if ! alive "$qto"; then qfinish "$f" "$qid" "iptal (hedef kapali)"; continue; fi
    typing "$qto" || busy "$qto" && continue   # hala dolu -> sonraki turda
    if send_msg "$qto" "$qmsg"; then
      qfinish "$f" "$qid" "iletildi"
      echo "iletildi: $qid -> $qto"
    fi
  done
  # 2 gunden eski done kayitlarini temizle
  find "$QDONE" -name 'q*.json' -mmin +2880 -delete 2>/dev/null || true ;;
open)
  s="${1:?ad}"; d="${2:?klasor}"; shift 2
  resume=0; prompt=1
  for a in "$@"; do [ "$a" = "--resume" ] && resume=1; [ "$a" = "--no-prompt" ] && prompt=0; done
  if alive "$s"; then echo "$s zaten acik"; exit 0; fi
  tmux new-session -d -s "$s" -c "$d"
  if [ "$resume" -eq 1 ]; then tmux send-keys -t "$s" 'claude --dangerously-skip-permissions -c' Enter
  else tmux send-keys -t "$s" 'claude --dangerously-skip-permissions' Enter; fi
  picked=0; ready=0
  for i in $(seq 1 45); do
    p=$(tmux capture-pane -t "$s" -p 2>/dev/null)
    if [ $picked -eq 0 ] && echo "$p" | grep -qiE 'resume from summary|resume full session'; then
      tmux send-keys -t "$s" Down; sleep 0.5; tmux send-keys -t "$s" Enter; picked=1; sleep 2; continue  # full resume (summary'ye HAYIR)
    fi
    echo "$p" | grep -qE 'bypass permissions|-- INSERT --' && { ready=1; break; }
    sleep 2
  done
  [ $ready -eq 1 ] || echo "UYARI: claude hazir gorunmedi (yine de devam)"
  sleep 1
  send_msg "$s" "/rename $s"; sleep 1
  send_msg "$s" "/remote-control"; sleep 1
  if [ $prompt -eq 1 ]; then
    send_msg "$s" "Selam, sen '$s' agentisin (ismine gore calisirsin; proje detayini kullanici sonra verebilir). Bu COK-SERVISLI bir sunucu (nginx 80/443 public + Cloudflare, Docker+systemd: gitea, mail, probot, kitap...). Orchestrator=server-main, evi /srv/server-main. ONCE OKU: /srv/server-main/AGENT-ONBOARDING.md (server + PORT kurallari) ve /srv/server-main/agentbook.json (agentlar + iletisim). DIGER AGENTLARLA KONUSMA: tmux send-keys -t <hedef> -l '<mesaj>' + AYRI Enter. Model secimi + codex + subagent kurallari global CLAUDE.md'inde (otomatik yuklu) - uygula. UYARI1 ghost-text: soluk oneri gercek degil. UYARI2 vim modu: submit icin cogu zaman fazladan Enter. Okuyunca kisa 'hazirim' de."
  fi
  book_set "$s" open "$d"
  rc=$(tmux capture-pane -t "$s" -p | grep -oE 'claude.ai/code/session_[A-Za-z0-9]+' | tail -1)
  echo "$s ACIK  ${rc:+rc:https://$rc}" ;;
close)
  s="${1:?ad}"
  alive "$s" && tmux kill-session -t "$s" && echo "$s kapatildi (gecmis jsonl'de durur)" || echo "$s zaten kapali"
  book_set "$s" closed ;;
*) grep -m12 '^#' "$0" | sed 's/^# \{0,1\}//' ;;
esac
#!/usr/bin/env bash
# wa — WhatsApp koprusu istemcisi (server-main ve diger agentlar kullanir)
#   wa send [--to <grup/kisi>] <mesaj...>   WhatsApp'a yolla (prefix [<agent>] otomatik eklenir)
#   wa read <grup/kisi> [N]                  o sohbetin son N mesaji (default 15)
#   wa chats                                 son gorulen sohbetler
# Cagiran agent adi = tmux oturum adi (AGENT env ile override edilebilir).
set -u
OUTBOX=/srv/whatsapp/outbox
STORE=/srv/whatsapp/messages.jsonl
AGENT="${AGENT:-$(tmux display-message -p '#S' 2>/dev/null || echo server-main)}"

case "${1:-}" in
  send)
    shift
    to=""; reply=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --to)    to="${2:-}"; shift 2;;
        --reply) reply="${2:-}"; shift 2;;   # alintili (native reply) cevap: orijinal msgId
        *) break;;
      esac
    done
    msg="$*"
    [ -n "$msg" ] || { echo "kullanim: wa send [--to <hedef>] [--reply <msgId>] \"<mesaj>\""; exit 1; }
    # prefix [<agent>] yoksa ekle
    case "$msg" in "[$AGENT]"*) ;; *) msg="[$AGENT] $msg";; esac
    mkdir -p "$OUTBOX"
    f="$OUTBOX/$(date +%s%N).json"
    python3 -c 'import json,sys
json.dump({"agent":sys.argv[1],"to":(sys.argv[2] or None),"replyTo":(sys.argv[3] or None),"text":sys.argv[4]}, open(sys.argv[5],"w"), ensure_ascii=False)' \
      "$AGENT" "$to" "$reply" "$msg" "$f"
    echo "kuyruga alindi -> ${to:-<varsayilan kanal>}${reply:+ (reply: $reply)}"
    ;;
  read)
    who="${2:?kullanim: wa read <grup/kisi> [N]}"; n="${3:-15}"
    python3 -c 'import json,sys
who=sys.argv[1].lower(); n=int(sys.argv[2]); store=sys.argv[3]
rows=[]
try:
  for line in open(store):
    try: r=json.loads(line)
    except: continue
    if (r.get("chatName","").lower()==who) or (r.get("senderName","").lower()==who):
      rows.append(r)
except FileNotFoundError: pass
for r in rows[-n:]:
  t=r.get("ts","")[11:16]
  print(t, r.get("senderName","?")+":", r.get("text",""))
if not rows: print("(kayit yok)")' "$who" "$n" "$STORE"
    ;;
  chats)
    python3 -c 'import json,sys
seen={}
try:
  for line in open(sys.argv[1]):
    try: r=json.loads(line)
    except: continue
    seen[r.get("chatName","?")]=r.get("ts","")[11:16]
except FileNotFoundError: pass
for k,v in list(seen.items())[-20:]: print(v, k)
if not seen: print("(kayit yok)")' "$STORE"
    ;;
  *) grep -m8 '^#' "$0" | sed 's/^# \{0,1\}//' ;;
esac
