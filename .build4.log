 	CGO_ENABLED=0 GOOS=darwin GOARCH=amd64 go build -trimpath -o site/bp-darwin-amd64 ./cmd/bp
 	CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -trimpath -o site/bp-darwin-arm64 ./cmd/bp
