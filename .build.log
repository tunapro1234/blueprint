    "claude_7d": {"provider": "claude", "reset_key": "7d", "duration": dt.timedelta(days=7)},
    "codex_5h": {"provider": "codex", "reset_key": "5h", "duration": dt.timedelta(hours=5)},
    "codex_7d": {"provider": "codex", "reset_key": "7d", "duration": dt.timedelta(days=7)},
}


def read_history() -> list[dict[str, Any]]:
    rows = []
    try:
        with HISTORY_PATH.open("r", encoding="utf-8") as handle:
            for line in handle:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(row, dict) and parse_iso(row.get("ts")):
                    rows.append(row)
    except OSError as exc:
        LOG(f"history okunamadı: {exc}")
    return rows


def reset_value(row: dict[str, Any], window: str) -> dt.datetime | None:
    config = WINDOWS[window]
    resets = row.get(f"{config['provider']}_resets")
    if not isinstance(resets, dict):
        return None
    return parse_iso(resets.get(config["reset_key"]))


def usage_value(row: dict[str, Any], window: str) -> float | None:
    value = row.get(window)
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def peak_for(rows: list[dict[str, Any]], window: str, reset_at: dt.datetime) -> tuple[float, float | None]:
    start = reset_at - WINDOWS[window]["duration"]
    values = []
    fable_values = []
    for row in rows:
        timestamp = parse_iso(row.get("ts"))
        if not timestamp or timestamp < start or timestamp > reset_at + dt.timedelta(minutes=2):
            continue
        value = usage_value(row, window)
        if value is not None:
            values.append(value)
        if window == "claude_7d":
            try:
                fable_values.append(float(row["claude_fable_7d"]))
            except (KeyError, TypeError, ValueError):
                pass
    return (max(values, default=0.0), max(fable_values) if fable_values else None)


def clean_number(value: float) -> int | float:
    return int(value) if value.is_integer() else round(value, 1)


def event_message(window: str, peak: float, fable_peak: float | None) -> str | None:
    provider = "Claude" if window.startswith("claude") else "Codex"
    peak_text = clean_number(peak)
    if window.endswith("_7d"):
        extra = f" (Fable %{clean_number(fable_peak)})" if fable_peak is not None and provider == "Claude" else ""
        return f"📅 {provider} haftalık reset — geçen hafta zirve %{peak_text}{extra}. Temiz hafta!"
    if peak >= 90:
        return f"🔄 {provider} 5h resetlendi — %{peak_text}'ye dayanmıştın, şimdi temiz."
    return None


