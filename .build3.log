+      color: white;
+      font-size: .75rem;
+      font-weight: 800;
+    }
+
+    pre {
+      margin: 16px 0 0;
+      overflow-x: auto;
+      border-radius: 9px;
+      padding: 14px;
+      background: var(--code);
