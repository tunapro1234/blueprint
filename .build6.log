+func TestLoadDashboardURL(t *testing.T) {
+	t.Run("default when missing", func(t *testing.T) {
+		got, err := loadDashboardURL(filepath.Join(t.TempDir(), "missing"))
+		if err != nil {
+			t.Fatal(err)
+		}
