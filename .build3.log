+
+  <main class="shell">
+    <section id="concepts">
+      <h2>Concepts</h2>
+      <div class="concepts">
+        <article class="concept">
+          <h3>Agent</h3>
+          <p>A CLI such as Claude or Codex living in its own named tmux session.</p>
+        </article>
+        <article class="concept">
+          <h3>Subagent</h3>
+          <p>An agent spawned inside a CLI through Task, a workflow, or <code>codex exec</code>.</p>
+        </article>
+        <article class="concept">
+          <h3>tmux is the fabric</h3>
+          <p>Sessions keep agents alive, addressable, observable, and easy to reconnect to.</p>
+        </article>
+        <article class="concept">
+          <h3>mosh makes remote sweet</h3>
+          <p>Roaming and intermittent connections are comfortable; SSH remains the automatic fallback.</p>
+        </article>
