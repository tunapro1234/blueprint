def is_wildcard_agent(name: Any) -> bool:
    return not isinstance(name, str) or not name or any(char in name for char in "*?[")


def build_agent_tree(
    server_book: dict[str, Any], probot_book: dict[str, Any], final_agent_row: dict[str, Any]
) -> dict[str, Any]:
    nodes: dict[str, dict[str, Any]] = {}
    parents: dict[str, str | None] = {}
    order: list[str] = []

    def merge_agent(source: dict[str, Any], parent: str | None) -> None:
        name = source.get("name")
        if is_wildcard_agent(name):
            return
        assert isinstance(name, str)
        if name not in nodes:
            nodes[name] = {
                "name": name,
                "nickname": None,
                "role": None,
                "status": None,
                "state": "unknown",
                "children": [],
            }
            order.append(name)
        node = nodes[name]
        nickname = source.get("nickname")
        role = source.get("role")
        status = source.get("status")
        if isinstance(nickname, str) and nickname:
            node["nickname"] = nickname
        if isinstance(role, str):
            node["role"] = role
        if status in {"open", "on-demand", "closed"}:
            node["status"] = status
        parents[name] = parent

    server_agents = server_book.get("agents")
    probot_agents = probot_book.get("agents")
    if not isinstance(server_agents, list) or not isinstance(probot_agents, list):
        raise ValueError("agentbook agents fields must be arrays")

    server_root = server_book.get("orchestrator", "server-main")
    if not isinstance(server_root, str) or not server_root:
        raise ValueError(f"{SERVER_BOOK_PATH}: invalid orchestrator")
    for source in server_agents:
        if not isinstance(source, dict):
            raise ValueError(f"{SERVER_BOOK_PATH}: every agent must be an object")
        name = source.get("name")
        merge_agent(source, None if name == server_root else server_root)

    if server_root not in nodes:
        merge_agent({"name": server_root}, None)

    book_default_parent = probot_book.get("parent", server_root)
    for source in probot_agents:
        if not isinstance(source, dict):
            raise ValueError(f"{PROBOT_BOOK_PATH}: every agent must be an object")
        parent = source.get("parent", book_default_parent)
        if parent is not None and not isinstance(parent, str):
            raise ValueError(f"{PROBOT_BOOK_PATH}: invalid parent for {source.get('name')!r}")
        merge_agent(source, parent)

    live_states = final_agent_row.get("agents")
    ts = final_agent_row.get("ts")
    parse_iso(ts, context=f"{AGENTS_PATH}:final.ts")
    if not isinstance(live_states, dict):
        raise ValueError(f"{AGENTS_PATH}: final agents field must be an object")
    for name, state in live_states.items():
        if not isinstance(name, str) or state not in {"busy", "idle"}:
            raise ValueError(f"{AGENTS_PATH}: invalid final agent state {name!r}: {state!r}")

    # Unknown live agents attach beneath the longest matching known name/nickname.
    known_before_live = list(order)
    for live_name, state in live_states.items():
        if live_name not in nodes:
            candidates: list[tuple[int, str]] = []
            for known_name in known_before_live:
                known_node = nodes[known_name]
                prefixes = (known_name, known_node["nickname"])
                for prefix in prefixes:
                    if isinstance(prefix, str) and live_name.startswith(prefix + "-"):
                        candidates.append((len(prefix), known_name))
            parent = max(candidates)[1] if candidates else server_root
            merge_agent({"name": live_name}, parent)
        nodes[live_name]["state"] = state

    # Repair absent parents to the main orchestrator; this also keeps the result connected.
    for name in order:
        parent = parents.get(name)
        if name != server_root and (parent is None or parent not in nodes or parent == name):
            parents[name] = server_root
    parents[server_root] = None

    for node in nodes.values():
        node["children"] = []
    roots: list[dict[str, Any]] = []
    for name in order:
        parent = parents.get(name)
        if parent is None:
            roots.append(nodes[name])
        else:
            nodes[parent]["children"].append(nodes[name])
    return {"ts": ts, "tree": roots}


def token_count(value: Any) -> int:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return 0
    if not math.isfinite(value) or value < 0:
        return 0
    return int(value)


def transcript_project(path: str) -> str:
    try:
        relative = Path(path).relative_to(PROJECTS_ROOT)
        return relative.parts[0]
    except (ValueError, IndexError):
        return "unknown"


def encoded_agent_folder(value: Any) -> str | None:
    """Convert an agentbook folder into Claude's encoded transcript directory prefix."""
    if not isinstance(value, str):
        try:
            offsets = load_offsets(offset_handle)
        except Exception as error:
            report_error("offset state read failed; rebuilding from transcripts", error)
            offsets = {}
        tokens, new_offsets = collect_token_deltas(offsets)
    except Exception as error:
        report_error("token delta collection failed", error)

    recorded = False
    try:
        append_json_line(AGENTS_FILE, {"ts": ts, "agents": agents, "tokens": tokens})
        recorded = True
    except Exception as error:
        report_error("agents history append failed", error)

    if offset_handle is not None:
        if recorded:
            try:
                save_offsets(offset_handle, new_offsets)
            except Exception as error:
                report_error("offset state write failed", error)
        try:
            fcntl.flock(offset_handle.fileno(), fcntl.LOCK_UN)
            offset_handle.close()
        except Exception as error:
            report_error("offset state close failed", error)


def main() -> int:
    ts = utc_now_iso()
    history: dict[str, Any] = {
        "ts": ts,
        "claude_5h": None,
        "claude_7d": None,
        "claude_fable_7d": None,
        "claude_resets": {"5h": None, "7d": None},
        "codex_5h": None,
        "codex_7d": None,
        "codex_resets": {"5h": None, "7d": None},
    }

    try:
        (
            history["claude_5h"],
            history["claude_7d"],
            history["claude_fable_7d"],
            history["claude_resets"],
        ) = collect_claude_usage()
    except Exception as error:
        report_error("Claude usage collection failed", error)

    try:
        history["codex_5h"], history["codex_7d"], history["codex_resets"] = (
            collect_codex_usage()
        )
    except Exception as error:
        report_error("Codex usage collection failed", error)

    try:
        append_json_line(HISTORY_FILE, history)
    except Exception as error:
        report_error("usage history append failed", error)

    try:
        collect_and_record_agents(ts)
    except Exception as error:
        report_error("agent snapshot failed", error)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as error:
        report_error("unexpected failure", error)
        raise SystemExit(0)
