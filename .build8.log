"""Apply a hysteretic Claude fleet policy from the latest usage-pulse sample."""

from __future__ import annotations

import fcntl
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any


USAGE_DIR = Path("/srv/server-main/usage")
HISTORY_FILE = USAGE_DIR / "history.jsonl"
STATE_FILE = USAGE_DIR / "policy-state.json"
LOG_FILE = USAGE_DIR / "policy.log"
LOCK_FILE = USAGE_DIR / ".policy.lock"
CONFIG_FILE = USAGE_DIR / "autopilot.conf"
PROJECTS_DIR = Path("/root/.claude/projects")
AGENTBOOKS = (
    Path("/srv/server-main/agentbook.json"),
    Path("/srv/probot/.orchestration/agentbook.json"),
)
WA_BIN = Path("/srv/server-main/bin/wa")

VALID_STATES = {"NORMAL", "FABLE_LIMIT", "CONSERVE", "EMERGENCY"}
VALID_MODELS = {"fable", "opus"}
VALID_EFFORTS = {"low", "medium", "high", "xhigh"}
STALE_SECONDS = 20 * 60
BRAKE_INTERVAL_SECONDS = 6 * 60 * 60


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def iso(value: datetime | None = None) -> str:
    return (value or utc_now()).isoformat(timespec="seconds").replace("+00:00", "Z")


def parse_time(value: Any) -> datetime | None:
    if not isinstance(value, str) or not value.strip():
        return None
    candidate = value.strip()
    if candidate.endswith("Z"):
        candidate = candidate[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(candidate)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def number(value: Any) -> float | None:
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)) and math.isfinite(float(value)):
        return float(value)
    if isinstance(value, str):
        try:
            parsed = float(value.strip().removesuffix("%"))
        except ValueError:
            return None
        return parsed if math.isfinite(parsed) else None
    return None


def fmt(value: float | None, digits: int = 1) -> str:
    if value is None:
        return "null"
    if float(value).is_integer():
        return str(int(value))
    return f"{value:.{digits}f}"


def default_state() -> dict[str, Any]:
    return {
        "state": "NORMAL",
        "pending": None,
        "pending_count": 0,
        "last_change": None,
        "override_until": None,
        "applied": {},
    }


def load_state(errors: list[str]) -> dict[str, Any]:
    state = default_state()
    try:
        raw = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if not isinstance(raw, dict):
            raise ValueError("state is not an object")
    except FileNotFoundError:
        return state
    except Exception as error:
        errors.append(f"state-read:{error}")
        return state

    if raw.get("state") in VALID_STATES:
        state["state"] = raw["state"]
    state["pending"] = raw.get("pending") if raw.get("pending") in VALID_STATES else None
    pending_count = raw.get("pending_count")
    if isinstance(pending_count, int) and not isinstance(pending_count, bool) and pending_count >= 0:
        state["pending_count"] = pending_count
    for key in ("last_change", "override_until"):
        value = raw.get(key)
        state[key] = value if value is None or isinstance(value, str) else None
    if isinstance(raw.get("applied"), dict):
        state["applied"] = raw["applied"]
    return state


def save_state(state: dict[str, Any]) -> None:
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=".policy-state.", dir=USAGE_DIR, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, STATE_FILE)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def append_log(record: dict[str, Any]) -> None:
    try:
        USAGE_DIR.mkdir(parents=True, exist_ok=True)
        line = json.dumps(record, ensure_ascii=False, separators=(",", ":"), default=str)
        line = line.replace("\n", "\\n").replace("\r", "\\r")
        with LOG_FILE.open("a", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            handle.write(line + "\n")
            handle.flush()
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    except Exception as error:
        print(f"usage-policy: log failed: {error}", file=sys.stderr)


def load_mode(errors: list[str]) -> str:
    try:
        lines = CONFIG_FILE.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return "enforce"
    except Exception as error:
        errors.append(f"config-read:{error}")
        return "enforce"
    for raw_line in lines:
        line = raw_line.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key == "mode":
            mode = value.strip("\"'").lower()
            if mode in {"advise", "enforce"}:
                return mode
            errors.append(f"config-mode:{mode or 'empty'}")
            return "enforce"
    return "enforce"


def last_history_record() -> dict[str, Any]:
    with HISTORY_FILE.open("rb") as handle:
        handle.seek(0, os.SEEK_END)
        position = handle.tell()
        if position == 0:

